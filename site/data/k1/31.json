وَوَصَّيْنَا الْإِنسَانَ بِوَالِدَيْهِ حَمَلَتْهُ أُمُّهُ وَهْنًا عَلَى وَهْن) لقمان:١٤\r\nمع قوله تعالى: (وَوَصَّيْنَا الْإِنسَانَ بِوَالِدَيْهِ إِحْسَانًا ۖ حَمَلَتْهُ أُمُّهُ كُرْهًا وَوَضَعَتْهُ كُرْهًا) الأحقاف:١٥، وقوله تعالى: (وَوَصَّيْنَا الْإِنسَانَ بِوَالِدَيْهِ حُسْنًا) العنكبوت:٨ \r\n\r\nوجه الإشكال بين عدم ذكر (الإحسان) في لقمان و(إحساناً) في الأحقاف و(حسناً) في العنكبوت.\r\nوالضابط: أنه لم يذكر الإحسان في لقمان للتوسع هناك في ذكر خصاله، واربط بين الهمزة في (إحسانًا) بالهمزة في الأحقاف، ويبقى (حسنًا) فتعرف أنها في العنكبوت.\r\nإشكال آخر بين زيادة (وهنًا على وهن) في لقمان و (كرهًا) في الأحقاف، والضابط: أن لقمان آخرها حرف النون، وكذا جملة (وهنًا على وهن) فتعرف أنها فيها.","ayetler":["46:15","29:8"]},{"not":"﴿وَوَصَّيْنَا الْإِنسَانَ بِوَالِدَيْهِ)","ayetler":["29:8","46:15"]},{"not":"\"ووصينا الإنسان بوالديه حملته أمه وهنًا على وهن\" لقمان\n\"ووصينا الإنسان بوالديه إحسانًا حملته أمه كُرهًا ووضعته كُرهًا\" الأحقاف \nالوهن في سورة لقمان - الرابط حرف النون ولم يرد الحمل في آية العنكبوت.","ayetler":["29:8","46:15"]}],"konu":[1280,2145,2144,1579,1285,367,850,1284],"ortak_ifade":[{"ifade":"وَوَصَّيْنَا الْإِنْسَانَ بِوَالِدَيْهِ","uzunluk":3,"ayetler":["29:8","46:15"]}],"ortak_ifade_toplam":2,"ortak_ifade_grup":1,"ayni_bolum":{"bolum":3,"ayetler":["31:12","31:13","31:14","31:15","31:16","31:17","31:18","31:19"]}},"31:15":{"benzer_ifade":[{"not":"تشابه قوله تعالي {فأحكم بينكم} في آل عمران \r\nوبين قوله تعالي {فَأُنَبِّئُكُم}","ayetler":["3:55","29:8"]},{"not":"\"وإن جاهداك لتشرك بي ما ليس لك به علم فلا تطعهما\" العنكبوت \n\"وإن جاهداك على أن تشرك بي ما ليس لك به علم فلا تطعهما وصاحبهما في الدنيا معروفًا \" لقمان جاءت الزيادة بحرف الجر \"على\" والمصاحبة بالمعروف في الموضع المتأخر (سورة لقمان).","ayetler":["29:8"]}],"konu":[3842,1911,2461,210,2240,2731,1802,4907,136,2149,2772],"ortak_ifade":[{"ifade":"تُشْرِكَ بِي مَا لَيْسَ لَكَ بِهِ عِلْمٌ فَلَا تُطِعْهُمَا","uzunluk":9,"ayetler":["29:8"]},{"ifade":"ثُمَّ إِلَيَّ مَرْجِعُكُمْ فَأُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْم