{"ifade":"يَدْعُو مِنْ دُونِ اللَّهِ","uzunluk":4,"ayetler":["6:56","6:71","6:108","7:37","7:194","10:66","10:106","11:101","16:20","19:48","22:12","22:73","35:40","39:38","40:66","46:4"]},{"ifade":"مِنْ دُونِ اللَّهِ مَنْ","uzunluk":4,"ayetler":["42:46"]},{"ifade":"إِلَىٰ يَوْمِ الْقِيَامَةِ","uzunluk":3,"ayetler":["3:55","3:77","4:87","5:14","5:64","6:12","7:167","17:62","28:71","28:72","45:26","68:39"]},{"ifade":"يَدْعُو مِنْ دُونِ","uzunluk":3,"ayetler":["4:117","7:197","13:14","16:86","18:14","22:62","29:42","31:30","35:13","40:20","43:86"]},{"ifade":"وَمَنْ أَضَلُّ مِمَّنْ","uzunluk":3,"ayetler":["28:50","41:52"]}],"ortak_ifade_toplam":42,"ortak_ifade_grup":5,"ayni_bolum":{"bolum":2,"ayetler":["46:4","46:5","46:6","46:7","46:8","46:9","46:10","46:11","46:12","46:13","46:14"]}},"46:6":{"ortak_ifade":[{"ifade":"كَانُوا لَهُمْ أَعْدَاءً","uzunluk":3,"ayetler":["28:8"]}],"ortak_ifade_toplam":1,"ortak_ifade_grup":1,"ayni_bolum":{"bolum":2,"ayetler":["46:4","46:5","46:6","46:7","46:8","46:9","46:10","46:11","46:12","46:13","46:14"]}},"46:7":{"benzer_ifade":[{"not":"تشابه في قوله تعالى ﴿وَإِذَا تُتْلَى عَلَيْهِمْ آيَاتُنَا بَيِّنَاتٍ﴾","ayetler":["10:15","19:73","22:72","34:43","45:25"]},{"not":"ضبط ( قال الذين كفروا للذين آمنوا ) مريم \r\nو ( قال الذين كفروا للحق ) الأحقاف","ayetler":["19:73"]},{"not":"قال تعالى: (وَإِذَا تُتْلَىٰ عَلَيْهِمْ آيَاتُنَا قَالُوا قَدْ سَمِعْنَا لَوْ نَشَاءُ لَقُلْنَا مِثْلَ هَٰذَا ۙ إِنْ هَٰذَا إِلَّا أَسَاطِيرُ الْأَوَّلِينَ) الأنفال:٣١. فبهذا التركيب (آياتنا) بدون (بينات) لم يرد إلا في هذا الموضع، وباقي القرآن (آياتنا بينات)، كما في يونس ومريم والحج وسبأ والجاثية والأحقاف، ولا يرد علينا هنا: (وَإِذَا تُتْلَىٰ عَلَيْهِ آيَاتُنَا وَلَّىٰ مُسْتَكْبِرًا) لقمان:٧، لعدم إشكالها.","ayetler":["8:31","10:15","19:73","22:72","34:43","45:25"]},{"not":"(وإِذا تُتلَى عليهِم آياتُنا بَيِّناتٍ) (وإِذا تُتلَى عليهِم آياتُنا) وردت الآية بزيادة كلمة \"بينات\" في ٦ مواضع في القرآن. ووردت بدون كلمة \"بينات\" في #موضع_وحيد في #سورة_الأنفال (وإِذا تُتلَى عليهِم آياتُنا قالُوا قد سَمِعنَا لو نَشاءُ لقُلْنا مِثلَ هذا..).","ayetler":["10:15","19:73","22:72","28:36","34:43","45:25"]},{"not":"تميزت سورة الأحقاف بقلة التركيب اللفظي عن متشابهاتها","ayetler":["46:10","41:52","34:43"]},{"not":"(وإِذا تُتلَى عليهِم آياتُنا بَيِّناتٍ) (وإِذا تُتلَى عليهِم آياتُنا) \nوردت الآية بزيادة كلمة \"بينات\" في ٦ مواضع في القرآن. \nووردت بدون كلمة \"بينات\" في موضع وحيد في سورة الأنفال \n(وإِذا تُتلَى عليهِم آياتُنا قالُوا قد سَمِعنَا لو نَشاءُ لقُلْنا مِثلَ هذا..).","ayetler":["8:31","10:15","19:73","22:72","34:43","45:25"]}],"ortak_ifade":[{"ifade":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ آيَاتُنَا بَيِّنَاتٍ قَالَ الَّذِينَ كَفَرُوا","uzunluk":8,"ayetler":["19:73"]},{"ifade":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ آيَاتُنَا بَيِّنَاتٍ قَالَ الَّذِينَ","uzunluk":7,"ayetler":["10:15"]},{"ifade":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ آيَاتُنَا بَيِّنَاتٍ قَالَ","uzunluk":6,"ayetler":["34:43"]},{"ifade":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ آيَاتُنَا بَيِّنَاتٍ","uzunluk":5,"ayetler":["22:72","45:25"]},{"ifade":"بَيِّنَاتٍ قَالَ الَّذِينَ كَفَرُوا","uzunluk":4,"ayetler":["5:110"]},{"ifade":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ آيَاتُنَا","uzunluk":4,"ayetler":["8:2","8:31","19:58","31:7","68:15","83:13"]},{"ifade":"تُتْلَىٰ عَلَيْهِمْ آيَاتُنَا","uzunluk":3,"ayetler":["2:129","2:151","3:101","3:164","28:45","28:59","39:71","62:2","65:11"]},{"ifade":"قَالَ الَّذِينَ كَفَرُوا","uzunluk":3,"ayetler":["3:12","4:51","6:7","6:25","8:38","11:7","13:7","13:27","13:43","14:13","25:4","25:32","27:67","29:12","30:58","34:3","34:7","34:31","36:47","41:26","41:29","46:11"]},{"ifade":"لِلْحَقِّ لَمَّا جَاءَهُمْ","uzunluk":3,"ayetler":["6:5","10:77","29:68","50:5"]},{"ifade":"هَٰذَا سِحْرٌ مُبِينٌ","uzunluk":3,"ayetler":["10:76","27:13","61:6"]},{"ifade":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ","uzunluk":3,"ayetler":["17:107","28:53"]},{"ifade":"آيَاتُنَا بَيِّنَاتٍ قَالَ","uzunluk":3,"ayetler":["28:36"]}],"ortak_ifade_toplam":53,"ortak_ifade_grup":12,"ayni_bolum":{"bolum":2,"ayetler":["46:4","46:5","46:6","46:7","46:8","46:9","46:10","46:11","46:12","46:13","46:14"]}},"46:8":{"benzer_ifade":[{"not":"\"شهيداً بيني وبينكم\"جميع المواضع عدا العنكبوت\" \nبيني وبينكم شهيداً\" لجدال أهل الكتاب ؛ فتقدم المتجادلون.","ayetler":["13:43","17:17"]}],"ortak_ifade":[{"ifade":"أَمْ يَقُولُونَ افْتَرَاهُ قُلْ إِنِ افْتَرَيْتُهُ","uzunluk":6,"ayetler":["11:35"]},{"ifade":"أَمْ يَقُولُونَ افْتَرَاهُ قُلْ","uzunluk":4,"ayetler":["10:38","11:13"]},{"ifade":"مِنَ اللَّهِ شَيْئًا","uzunluk":3,"ayetler":["3:10","3:116","5:17","5:41","45:19","48:11","58:17","66:10"]},{"ifade":"شَهِيدًا بَيْنِي وَبَيْنَكُمْ","uzunluk":3,"ayetler":["6:19","10:29","13:43","17:96"]},{"ifade":"وَهُوَ الْغَفُورُ الرَّحِيمُ","uzunluk":3,"ayetler":["10:107"]},{"ifade":"بِمَا تُفِيضُونَ فِيهِ","uzunluk":3,"ayetler":["24:14"]},{"ifade":"أَمْ يَقُولُونَ افْتَرَاهُ","uzunluk":3,"ayetler":["32:3","42:24"]}],"ortak_ifade_toplam":19,"ortak_ifade_grup":7,"ayni_bolum":{"bolum":2,"ayetler":["46:4","46:5","46:6","46:7","46:8","46:9","46:10","46:11","46:12","46:13","46:14"]}},"46:9":{"ortak_ifade":[{"ifade":"إِنْ أَتَّبِعُ إِلَّا مَا يُوحَىٰ إِلَيَّ","uzunluk":6,"ayetler":["6:50","10:15"]},{"ifade":"أَنَا إِلَّا نَذِيرٌ مُبِينٌ","uzunluk":4,"ayetler":["26:115"]},{"ifade":"يُوحَىٰ إِلَيَّ وَمَا","uzunluk":3,"ayetler":["3:44","11:49","12:102","42:13"]},{"ifade":"مَا يُوحَىٰ إِلَيَّ","uzunluk":3,"ayetler":["4:163","6:106","6:145","7:203","10:109","11:12","12:3","18:27","29:45","33:2","34:50"]},{"ifade":"إِنْ أَتَّبِعُ إِلَّا","uzunluk":3,"ayetler":["6:116","6:148","10:66","17:47","25:8","53:23","53:28"]},{"ifade":"إِلَّا نَذِيرٌ مُبِينٌ","uzunluk":3,"ayetler":["7:184"]},{"ifade":"أَنَا إِلَّا نَذِيرٌ","uzunluk":3,"ayetler":["7:188"]},{"ifade":"قُلْ مَا كُنْتُ","uzunluk":3,"ayetler":["24:16"]},{"ifade":"وَمَا أَدْرِي مَا","uzunluk":3,"ayetler":["45:32"]}],"ortak_ifade_toplam":29,"ortak_ifade_grup":9,"ayni_bolum":{"bolum":2,"ayetler":["46:4","46:5","46:6","46:7","46:8","46:9","46:10","46:11","46:12","46:13","46:14"]}},"46:10":{"benzer_ifade":[{"not":"(من عند الله)","ayetler":["2:103","3:37","4:78","8:10","24:61","28:60","41:52"]},{"not":"قال تعالى: (قُلْ أَرَأَيْتُمْ إِن كَانَ مِنْ عِندِ اللَّهِ ثُمَّ كَفَرْتُم بِهِ) فصلت52 مع قوله تعالى: (قُلْ أَرَأَيْتُمْ إِن كَانَ مِنْ عِندِ اللَّهِ وَكَفَرْتُم بِهِ) الأحقاف:10. وجه الإشكال بين (ثم) و(الواو)، والثاء متقدمة هجائيا على الواو في (وكفرتم) .","ayetler":["41:52"]},{"not":"قال جمال عبد الرحمن إسماعيل :\n\tآآ. (ثم كفرتم) أُورِدَت في فصلت\n\t\tمعاذ ربي من قلوبٍ فُتِنَت\n    أشار إلى الاشتباه الوارد عند بعضهم بين ﴿قُلْ أَرَأَيْتُمْ إِن كَانَ مِنْ عِندِ اللَّهِ ثُمَّ كَفَرْتُم بِهِ﴾ فصلت:52، \nو ﴿قُلْ أَرَأَيْتُمْ إِن كَانَ مِنْ عِندِ اللَّهِ وَكَفَرْتُم بِهِ﴾ الأحقاف:10، فالأولى في فصلت وما عداها جاء بالواو.","ayetler":["41:52"]},{"not":"في العنكبوت ( ولقد تركنا منها آية) ، وفي القمر (وقد تركناها آية).\n\nفي السجدة (ثم كفرتم به) ، وفي الأحقاف (وكفرتم به).","ayetler":["29:35","54:15","41:52"]},{"not":"تميزت سورة الأحقاف بقلة التركيب اللفظي عن متشابهاتها","ayetler":["46:7","41:52","34:43"]}],"ortak_ifade":[{"ifade":"قُلْ أَرَأَيْتُمْ إِنْ كَانَ مِنْ عِنْدِ اللَّهِ","uzunluk":7,"ayetler":["41:52"]},{"ifade":"إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ","uzunluk":6,"ayetler":["5:51","6:144","28:50"]},{"ifade":"اللَّهَ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ","uzunluk":5,"ayetler":["2:258","3:86","9:19","9:109","61:7","62:5"]},{"ifade":"إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ","uzunluk":5,"ayetler":["5:67","63:6"]},{"ifade":"اللَّهَ لَا يَهْدِي الْقَوْمَ","uzunluk":4,"ayetler":["2:264","5:108","9:24","9:37","9:80","16:107","61:5"]},{"ifade":"مِنْ بَنِي إِسْرَائِيلَ عَلَىٰ","uzunluk":4,"ayetler":["5:78"]},{"ifade":"إِنَّ اللَّهَ لَا يَهْدِي","uzunluk":4,"ayetler":["16:37","39:3","40:28"]},{"ifade":"إِنَّ اللَّهَ لَا","uzunluk":3,"ayetler":["2:26","2:190","3:5","3:9","3:32","4:36","4:40","4:48","4:107","5:87","7:28","8:58","9:96","9:120","10:44","10:81","11:115","12:90","13:11","13:31","22:38","28:76","28:77","31:18"]},{"ifade":"مِنْ عِنْدِ اللَّهِ","uzunluk":3,"ay