{"version":"k1-2026.10.23","ayetler":{"62:1":{"benzer_ifade":[{"not":"التشابه في في آيات التسبيح في بدايات السور\n( الحديد - الحشر - الصف - الجمعة - التغابن)","ayetler":["57:1","59:1","61:1","64:1"]}],"ortak_ifade":[{"ifade":"يُسَبِّحُ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ","uzunluk":8,"ayetler":["59:1","61:1","64:1"]},{"ifade":"لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ","uzunluk":7,"ayetler":["2:284","3:109","3:129","4:126","4:131","4:132","53:31"]},{"ifade":"مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ","uzunluk":6,"ayetler":["2:255","3:29","4:171","5:97","10:68","14:2","16:49","20:6","22:64","31:20","34:1","42:4","42:53","45:13","49:16","58:7"]},{"ifade":"يُسَبِّحُ لِلَّهِ مَا فِي السَّمَاوَاتِ","uzunluk":5,"ayetler":["57:1"]},{"ifade":"لِلَّهِ مَا فِي السَّمَاوَاتِ","uzunluk":4,"ayetler":["4:170","10:55","24:64","31:26"]},{"ifade":"وَمَا فِي الْأَرْضِ","uzunluk":3,"ayetler":["2:29","5:36","8:63","10:54","13:18","22:65","39:47"]},{"ifade":"مَا فِي السَّمَاوَاتِ","uzunluk":3,"ayetler":["2:116","6:12","16:52","22:70","29:52","59:24","64:4"]},{"ifade":"لِلَّهِ مَا فِي","uzunluk":3,"ayetler":["3:154","4:63"]},{"ifade":"فِي السَّمَاوَاتِ وَمَا","uzunluk":3,"ayetler":["29:22"]}],"ortak_ifade_toplam":48,"ortak_ifade_grup":9},"62:2":{"benzer_ifade":[{"not":"قال تعالى: (رَبَّنَا وَابْعَثْ فِيهِمْ رَسُولًا مِّنْهُمْ يَتْلُوا عَلَيْهِمْ آيَاتِكَ وَيُعَلِّمُهُمُ الْكِتَابَ وَالْحِكْمَةَ وَيُزَكِّيهِمْ ۚ إِنَّكَ أَنتَ الْعَزِيزُ الْحَكِيمُ) البقرة:١٢٩. فتأخير (التزكية) على العلم في قوله: (ويعلمهم الكتاب والحكمة ويزكيهم) الوحيدة، وما عداها بخلافها، كما في آل عمران ١٦٤، والجمعة ٢.","ayetler":["2:129","3:164"]},{"not":"(رسولاً من أنفسهم) الوحيدة والباقي (رسولاً منهم) في 3 مواضع (البقرة والمؤمنون والجمعة).","ayetler":["3:164","2:129","23:32"]}],"ortak_ifade":[{"ifade":"يَتْلُو عَلَيْهِمْ آيَاتِهِ وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ الْكِتَابَ وَالْحِكْمَةَ وَإِنْ كَانُوا مِنْ قَبْلُ لَفِي ضَلَالٍ مُبِينٍ","uzunluk":14,"ayetler":["3:164"]},{"ifade":"رَسُولًا مِنْهُمْ ي