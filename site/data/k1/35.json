ْ فَضْلِهِ وَلَعَلَّكُمْ تَشْكُرُونَ","uzunluk":5,"ayetler":["16:14","28:73","30:46","45:12"]},{"ifade":"الْبَحْرَانِ هَٰذَا عَذْبٌ فُرَاتٌ","uzunluk":4,"ayetler":["25:53"]},{"ifade":"لِتَبْتَغُوا مِنْ فَضْلِهِ","uzunluk":3,"ayetler":["17:66","62:10","73:20"]}],"ortak_ifade_toplam":8,"ortak_ifade_grup":3,"ayni_bolum":{"bolum":2,"ayetler":["35:3","35:4","35:5","35:6","35:7","35:8","35:9","35:10","35:11","35:12","35:13","35:14"]}},"35:13":{"benzer_ifade":[{"not":"التشابه فى قوله (ذَلِكُمُ اللَّهُ رَبُّكُمْ)","ayetler":["6:102","40:62"]},{"not":"تشابه في قوله تعالى ﴿كُلٌّ يَجْرِي لِأَجَلٍ مُّسَمًّى ﴾","ayetler":["13:2","31:29","39:5"]},{"not":"ضبط الآية (لأجل مسمي)","ayetler":["13:2","39:5"]},{"not":"ضبط الآية (وسخر الشمس والقمر كل يجري إلى اجل مسمي)","ayetler":["13:2","39:5","31:29"]},{"not":"قال تعالى: (أَلَمْ تَرَ أَنَّ اللَّهَ يُولِجُ اللَّيْلَ فِي النَّهَارِ وَيُولِجُ النَّهَارَ فِي اللَّيْلِ وَسَخَّرَ الشَّمْسَ وَالْقَمَرَ كُلٌّ يَجْرِي إِلَىٰ أَجَلٍ مُّسَمًّى وَأَنَّ اللَّهَ بِمَا تَعْمَلُونَ خَبِيرٌ) لقمان:٢٩.\r\nقوله (إلى أجل مسمى) الوحيدة في القرآن، وما عداها (لأجل مسمى) كما في الرعد وفاطر والزمر.","ayetler":["31:29","13:2","39:5"]},{"not":"(تولج) بالتاء في آل عمران فقط\nوالباقي كلها (يولج)","ayetler":["3:27","22:61","31:29","57:6"]},{"not":"(وَسَخَّرَ الشَّمْسَ وَالْقَمَرَ كُلٌّ يَجْرِي لِأَجَلٍ مُّسَمًّى)","ayetler":["13:2","39:5"]},{"not":"قال تعالى: - \"وسخَّر الشمس والقمر كُلٌّ يجري لأجلٍ مسمًّى\" [الرعد، فاطر، الزمر] \n\"وسخَّر الشمس والقمر كُلٌّ يجري (إلى) أجلٍ مُسمًّى\" [لقمان] \nكل ما جاء في القرآن \"كلٌّ يجري لأجل مسمًّى\" \nما عدا موضع وحيد في سورة لقمان: \"كلٌّ يجري (إلى) أجل مسمًّى\".","ayetler":["13:2","31:29","39:5"]}],"konu":[3202,2820,1901,3809,2988,2989,1653,2990,2586,2778,901,621],"ortak_ifade":[{"ifade":"يُولِجُ اللَّيْلَ فِي النَّهَارِ وَيُولِجُ النَّهَارَ فِي اللَّيْلِ وَسَخَّرَ الشَّمْسَ وَالْقَمَرَ كُلٌّ يَجْرِي","uzunluk":13,"ayetler":["31:29"]},{"ifade":"يُولِجُ اللَّيْلَ فِي النَّهَارِ وَيُولِجُ النَّهَارَ فِي اللَّيْلِ","uzunluk":8