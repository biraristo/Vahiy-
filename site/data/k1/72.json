2:9","72:10","72:11","72:12","72:13","72:14","72:15","72:16","72:17","72:18","72:19","72:20","72:21","72:22","72:23","72:24","72:25","72:26","72:27","72:28"]}},"72:19":{"ayni_bolum":{"bolum":1,"ayetler":["72:1","72:2","72:3","72:4","72:5","72:6","72:7","72:8","72:9","72:10","72:11","72:12","72:13","72:14","72:15","72:16","72:17","72:18","72:19","72:20","72:21","72:22","72:23","72:24","72:25","72:26","72:27","72:28"]}},"72:20":{"ortak_ifade":[{"ifade":"وَلَا أُشْرِكُ بِهِ","uzunluk":3,"ayetler":["3:64","4:36","13:36"]},{"ifade":"رَبِّي وَلَا أُشْرِكُ","uzunluk":3,"ayetler":["18:38","23:59"]}],"ortak_ifade_toplam":5,"ortak_ifade_grup":2,"ayni_bolum":{"bolum":1,"ayetler":["72:1","72:2","72:3","72:4","72:5","72:6","72:7","72:8","72:9","72:10","72:11","72:12","72:13","72:14","72:15","72:16","72:17","72:18","72:19","72:20","72:21","72:22","72:23","72:24","72:25","72:26","72:27","72:28"]}},"72:21":{"ortak_ifade":[{"ifade":"لَا أَمْلِكُ لَكُمْ ضَرًّا وَلَا","uzunluk":5,"ayetler":["5:76"]},{"ifade":"إِنِّي لَا أَمْلِكُ","uzunluk":3,"ayetler":["5:25"]},{"ifade":"قُلْ إِنِّي لَا","uzunluk":3,"ayetler":["6:33"]},{"ifade":"لَا أَمْلِكُ لَكُمْ","uzunluk":3,"ayetler":["29:17"]}],"ortak_ifade_toplam":4,"ortak_ifade_grup":4,"ayni_bolum":{"bolum":1,"ayetler":["72:1","72:2","72:3","72:4","72:5","72:6","72:7","72:8","72:9","72:10","72:11","72:12","72:13","72:14","72:15","72:16","72:17","72:18","72:19","72:20","72:21","72:22","72:23","72:24","72:25","72:26","72:27","72:28"]}},"72:22":{"ortak_ifade":[{"ifade":"وَلَنْ أَجِدَ مِنْ دُونِهِ مُلْتَحَدًا","uzunluk":5,"ayetler":["18:27"]},{"ifade":"وَلَنْ أَجِدَ مِنْ دُونِهِ","uzunluk":4,"ayetler":["18:58"]},{"ifade":"قُلْ إِنِّي لَنْ","uzunluk":3,"ayetler":["18:67","18:72"]},{"ifade":"أَجِدَ مِنْ دُونِهِ","uzunluk":3,"ayetler":["18:93","28:23"]}],"ortak_ifade_toplam":6,"ortak_ifade_grup":4,"ayni_bolum":{"bolum":1,"ayetler":["72:1","72:2","72:3","72:4","72:5","72:6","72:7","72:8","72:9","72:10","72:11","72:12","72:13","72:14","72:15","72:16","72:17","72:18","72:19","72:20","72:21","72:22","72:23","72:24","72:25","72:26","72:27","72:28"]}},"72:23":{"benzer_ifade":[{"not":"ضبط الآية خالدين فيها أبدا مع النار","ayetler":["4:169","33:65"]},{"not":"(نساء الجن أحزاب):\r\nوهذه الجملة تشير إلى السور التي جاء فيها (خالدين فيها أبدًا) في حق الكفار وهي في سورة النساء (إِلَّا طَرِيقَ جَهَنَّمَ خَالِدِينَ فِيهَا أَبَدًا ۚ وَكَانَ ذَلِكَ عَلَى اللَّهِ يَسِيرًا) النساء:١٦٩.\r\nوسورة الأحزاب (خَالِدِينَ فِيهَا أَبَدًا ۖ لَّا يَجِدُونَ وَلِيًّا وَلَا نَصِيرًا) الأحزاب:٦٥\r\nوسورة الجن (إِلَّا بَلَاغًا مِّنَ اللَّهِ وَرِسَالَاتِهِ ۚ وَمَن يَعْصِ اللَّهَ وَرَسُولَهُ فَإِنَّ لَهُ نَارَ جَهَنَّمَ خَالِدِينَ فِيهَا أَبَدًا) الجن:٢٣. \r\n\r\nأما (خالدين فيها أبدًا) في حق المؤمنين، فقد جاءت في ٨ مواضع،\r\nفي سورة النساء موضعان ٥٧ و١٢٢، والتوبة ٢٢ و١٠٠، والمائدة ١١٩، والتغابن ٩، والطلاق ١١، والبينة ٨. \r\n\r\nفائدة: لا تجتمع كلمة (أبدآً) في قوله تعالى (خَالِدِينَ فِيهَا أَبَدًا) \r\nمع كلمة (هو) في مثل قوله تعالى: (ذَلِكَ هُوَ الْفَوْزُ الْعَظِيمُ) \r\nوانظر للفائدة: المائدة ١١٩ – التوبة ٧٢ – التوبة ١٠٠ – الحديد ١٢ – التغابن ٩.","ayetler":["33:65","4:169"]},{"not":"(فأنَّ له نار جهنم، فإنَّ له نار جهنم):\r\n\tمن المواضع كذلك المتشابهة والتي تُضبَط بهذه القاعدة: ما جاء في سورة التوبة في قوله تعالى:﴿ أَلَمْ يَعْلَمُوا أَنَّهُ مَن يُحَادِدِ اللَّهَ وَرَسُولَهُ فَأَنَّ لَهُ نَارَ جَهَنَّمَ خَالِدًا فِيهَا ۚ ذَٰلِكَ الْخِزْيُ الْعَظِيمُ﴾ التوبة:63، \r\nمع قوله تعالى:﴿ إِلَّا بَلَاغًا مِّنَ اللَّهِ وَرِسَالَاتِهِ ۚ وَمَن يَعْصِ اللَّهَ وَرَسُولَهُ فَإِنَّ لَهُ نَارَ جَهَنَّمَ خَالِدِينَ فِيهَا أَبَدًا﴾ الجن:23.\r\n\tفالإشكال عندنا بين فتحة الهمزة (فأن) وكسرها. والضابط: أن تتذكر الفتحة في وسط اسم السورة (التَّوبة)، حيث جاء فيها الفتح (فأن)، وتتذكر الكسرة في وسط اسم السورة (الجِنّ)، حيث جاء فيها الكسر (فإنّ).","ayetler":["9:63"]},{"not":"(خالدين فيها أبداً)\nأتت (أبداً) في 11 موضع من القرآن فقط","ayetler":["4:57","4:122","4:169","5:119","9:22","9:100","33:65","64:9","65:11","98:8"]},{"not":"ورد لفظ ( خالدين فيها ابدا) عن أهل النار ثلاث مرات فقط.","ayetler":["4:169","33:65"]}],"ortak_ifade":[{"ifade":"لَهُ نَارَ جَهَنَّمَ خَالِدِينَ فِيهَا","uzunluk":5,"ayetler":["9:63"]},{"ifade":"وَمَنْ يَعْصِ اللَّهَ وَرَسُولَهُ","uzunluk":4,"ayetler":["4:14","33:36"]},{"ifade":"جَهَنَّمَ خَالِدِينَ فِيهَا أَبَدًا","uzunluk":4,"ayetler":["4:169"]},{"ifade":"نَارَ جَهَنَّمَ خَالِدِينَ فِيهَا","uzunluk":4,"ayetler":["9:68","98:6"]},{"ifade":"خَالِدِينَ فِيهَا أَبَدًا","uzunluk":3,"ayetler":["4:57","4:122","5:119","9:22","9:100","33:65","64:9","65:11","98:8"]},{"ifade":"جَهَنَّمَ خَالِدِينَ فِيهَا","uzunluk":3,"ayetler":["4:93","16:29","39:72","40:76"]},{"ifade":"اللَّهَ وَرَسُولَهُ فَإِنَّ","uzunluk":3,"ayetler":["8:13","33:33","48:13"]}],"ortak_ifade_toplam":22,"ortak_ifade_grup":7,"ayni_bolum":{"bolum":1,"ayetler":["72:1","72:2","72:3","72:4","72:5","72:6","72:7","72:8","72:9","72:10","72:11","72:12","72:13","72:14","72:15","72:16","72:17","72:18","72:19","72:20","72:21","72:22","72:23","72:24","72:25","72:26","72:27","72:28"]}},"72:24":{"benzer_ifade":[{"not":"تشابه فى قوله تعالى ( فسيعلمون )","ayetler":["19:75"]}],"ortak_ifade":[{"ifade":"حَتَّىٰ إِذَا رَأَوْا مَا يُوعَدُونَ","uzunluk":5,"ayetler":["19:75"]},{"ifade":"رَأَوْا مَا يُوعَدُونَ","uzunluk":3,"ayetler":["46:35"]}],"ortak_ifade_toplam":2,"ortak_ifade_grup":2,"ayni_bolum":{"bolum":1,"ayetler":["72:1","72:2","72:3","72:4","72:5","72:6","72:7","72:8","72:9","72:10","72:11","72:12","72:13","72:14","72:15","72:16","72:17","72:18","72:19","72:20","72:21","72:22","72:23","72:24","72:25","72:26","72:27","72:28"]}},"72:25":{"ortak_ifade":[{"ifade":"إِنْ أَدْرِي أَقَرِيبٌ","uzunluk":3,"ayetler":["21:109"]}],"ortak_ifade_toplam":1,"ortak_ifade_grup":1,"ayni_bolum":{"bolum":1,"ayetler":["72:1","72:2","72:3","72:4","72:5","72:6","72:7","72:8","72:9","72:10","72:11","72:12","72:13","72:14","72:15","72:16","72:17","72:18","72:19","72:20","72:21","72:22","72:23","72:24","72:25","72:26","72:27","72:28"]}},"72:26":{"ortak_ifade":[{"ifade":"عَالِمُ الْغَيْبِ فَلَا","uzu