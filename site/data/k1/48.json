لفتح، وحيث إن الكثير من الحَفَظَة لا يشكل عليه معرفة موقع الآية وإنما يشكل عليه التقديم والتأخير بين (نفعًا وضرًا) وبمعرفة هذه القاعدة يزول هذا الإشكال -بإذن الله-.","ayetler":["7:188","13:16","34:42","5:76","10:49","20:89","25:3"]}],"ortak_ifade":[{"ifade":"مِنَ اللَّهِ شَيْئًا إِنْ أَرَادَ","uzunluk":5,"ayetler":["5:17"]},{"ifade":"اللَّهُ بِمَا تَعْمَلُونَ خَبِيرًا","uzunluk":4,"ayetler":["2:234","2:271","3:180","31:29","57:10","58:3","58:11","64:8"]},{"ifade":"مَا لَيْسَ فِي قُلُوبِهِمْ","uzunluk":4,"ayetler":["3:167"]},{"ifade":"كَانَ اللَّهُ بِمَا تَعْمَلُونَ","uzunluk":4,"ayetler":["4:108","33:9","48:24","57:4"]},{"ifade":"اللَّهُ بِمَا تَعْمَلُونَ","uzunluk":3,"ayetler":["2:110","2:233","2:237","2:265","2:283","3:120","3:156","8:39","8:47","8:72","24:28","60:3","64:2"]},{"ifade":"مِنَ اللَّهِ شَيْئًا","uzunluk":3,"ayetler":["3:10","3:116","5:41","45:19","46:8","58:17","66:10"]},{"ifade":"بِمَا تَعْمَلُونَ خَبِيرًا","uzunluk":3,"ayetler":["4:94","4:128","4:135","11:111","33:2"]},{"ifade":"فِي قُلُوبِهِمْ قُلْ","uzunluk":3,"ayetler":["9:64"]},{"ifade":"إِنْ أَرَادَ بِكُمْ","uzunluk":3,"ayetler":["33:17"]},{"ifade":"لَكُمْ مِنَ اللَّهِ","uzunluk":3,"ayetler":["40:33"]},{"ifade":"الْمُخَلَّفُونَ مِنَ الْأَعْرَابِ","uzunluk":3,"ayetler":["48:16"]}],"ortak_ifade_toplam":43,"ortak_ifade_grup":11},"48:12":{"ortak_ifade":[{"ifade":"ظَنَنْتُمْ أَنْ لَنْ","uzunluk":3,"ayetler":["21:87","22:15","72:5","72:7","72:12","84:14"]},{"ifade":"وَكُنْتُمْ قَوْمًا بُورًا","uzunluk":3,"ayetler":["25:18"]}],"ortak_ifade_toplam":7,"ortak_ifade_grup":2},"48:13":{"ortak_ifade":[{"ifade":"يُؤْمِنْ بِاللَّهِ وَرَسُولِهِ","uzunluk":3,"ayetler":["3:179","4:136","4:152","4:171","7:158","24:47","24:62","48:9","49:15","57:7","57:8","57:19","57:21","58:4","61:11","64:8"]},{"ifade":"بِاللَّهِ وَرَسُولِهِ فَإِنَّا","uzunluk":3,"ayetler":["8:13","33:33","72:23"]},{"ifade":"فَإِنَّا أَعْتَدْنَا لِلْكَافِرِينَ","uzunluk":3,"ayetler":["76:4"]}],"ortak_ifade_toplam":20,"ortak_ifade_grup":3},"48:14":