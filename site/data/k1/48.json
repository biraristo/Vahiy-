{"version":"k1-2026.10.23","ayetler":{"48:1":{},"48:2":{"benzer_ifade":[{"not":"5-\t(ويتمُّ نعمته، ويتمَّ نعمته):\r\n\tالإشكال عندنا بين الضم في (يتم) وفتحها، حيث جاء الضم في سورة يوسف في قوله تعالى:﴿ وَكَذَٰلِكَ يَجْتَبِيكَ رَبُّكَ وَيُعَلِّمُكَ مِن تَأْوِيلِ الْأَحَادِيثِ وَيُتِمُّ نِعْمَتَهُ عَلَيْكَ﴾ يوسف:6 \r\nوجاء الفتح في سورة الفتح في قوله تعالى: ﴿لِّيَغْفِرَ لَكَ اللَّهُ مَا تَقَدَّمَ مِن ذَنبِكَ وَمَا تَأَخَّرَ وَيُتِمَّ نِعْمَتَهُ عَلَيْكَ وَيَهْدِيَكَ صِرَاطًا مُّسْتَقِيمًا﴾ الفتح:2.\r\n\tوالضابط: أن تربط بين الضم في (يتمُّ) بالضم في اسم السورة (يُوسُف)، وتربط بين الفتح في (ويتمَّ) بالفتح في الفاء من اسم السورة (الفَتح)، مع تذكر اسم السورة الفتح حيث يدل على ذلك.","ayetler":["12:6"]},{"not":"(ويتم نعمته عليك)","ayetler":["12:6"]}],"ortak_ifade":[{"ifade":"وَيَهْدِيَكَ صِرَاطًا مُسْتَقِيمًا","uzunluk":3,"ayetler":["1:6","4:68","37:118","48:20"]},{"ifade":"وَيُتِمَّ نِعْمَتَهُ عَلَيْكَ","uzunluk":3,"ayetler":["2:150","5:6","12:6","16:81"]}],"ortak_ifade_toplam":8,"ortak_ifade_grup":2},"48:3":{},"48:4":{"ortak_ifade":[{"ifade":"السَّمَاوَاتِ وَالْأَرْضِ وَكَانَ اللَّهُ عَلِيمًا حَكِيمًا","uzunluk":6,"ayetler":["4:170"]},{"ifade":"وَلِلَّهِ جُنُودُ السَّمَاوَاتِ وَالْأَرْضِ وَكَانَ اللَّهُ","uzunluk":6,"ayetler":["48:7"]},{"ifade":"وَكَانَ اللَّهُ عَلِيمًا حَكِيمًا","uzunluk":4,"ayetler":["4:17","4:92","4:104","4:111"]},{"ifade":"هُوَ الَّذِي أَنْزَلَ","uzunluk":3,"ayetler":["3:7","16:10"]},{"ifade":"اللَّهُ عَلِيمًا حَكِيمًا","uzunluk":3,"ayetler":["4:26","8:71","9:15","9:28","9:60","9:97","9:106","9:110","22:52","24:18","24:58","24:59","49:8","60:10"]},{"ifade":"وَالْأَرْضِ وَكَانَ اللَّهُ","uzunluk":3,"ayetler":["4:126","4:131"]},{"ifade":"السَّمَاوَاتِ وَالْأَرْضِ وَكَانَ","uzunluk":3,"ayetler":["6:75","21:30"]},{"ifade":"وَكَانَ اللَّهُ عَلِيمًا","uzunluk":3,"ayetler":["33:51"]}],"ortak_ifade_toplam":27,"ortak_ifade_grup":8},"48:5":{"ortak_ifade":[{"ifade":"الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا","u