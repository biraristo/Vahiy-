{"version":"k1-2026.10.23","ayetler":{"32:1":{"benzer_ifade":[{"not":"ضبط الآيـة ( الم )","ayetler":["2:1","3:1","29:1","30:1","31:1"]},{"not":"ضبط مواضع ( الم )","ayetler":["2:1","3:1","31:1","30:1","29:1"]}],"konu":[18],"ayni_bolum":{"bolum":1,"ayetler":["32:1","32:2","32:3"]}},"32:2":{"benzer_ifade":[{"not":"ضبط مواضع (الكتاب لا ريب فيه)","ayetler":["2:2","10:37"]}],"konu":[4138,4139,22,8,20,23],"ortak_ifade":[{"ifade":"الْكِتَابِ لَا رَيْبَ فِيهِ مِنْ رَبِّ الْعَالَمِينَ","uzunluk":7,"ayetler":["10:37"]},{"ifade":"الْكِتَابِ لَا رَيْبَ فِيهِ","uzunluk":4,"ayetler":["2:2"]},{"ifade":"لَا رَيْبَ فِيهِ","uzunluk":3,"ayetler":["3:9","3:25","4:87","6:12","17:99","18:21","22:7","40:59","42:7","45:26","45:32"]},{"ifade":"مِنْ رَبِّ الْعَالَمِينَ","uzunluk":3,"ayetler":["7:61","7:67","7:104","56:80","69:43"]}],"ortak_ifade_toplam":18,"ortak_ifade_grup":4,"ayni_bolum":{"bolum":1,"ayetler":["32:1","32:2","32:3"]}},"32:3":{"konu":[584,148,2676,3541,3515,2693],"ortak_ifade":[{"ifade":"مِنْ رَبِّكَ لِتُنْذِرَ قَوْمًا مَا أَتَاهُمْ مِنْ نَذِيرٍ مِنْ قَبْلِكَ لَعَلَّهُمْ","uzunluk":11,"ayetler":["28:46"]},{"ifade":"مِنْ قَبْلِكَ لَعَلَّهُمْ","uzunluk":3,"ayetler":["2:21","2:183"]},{"ifade":"الْحَقُّ مِنْ رَبِّكَ","uzunluk":3,"ayetler":["2:26","2:144","2:147","2:149","3:60","4:170","10:94","10:108","11:17","18:29","22:54","28:53","47:2","47:3"]},{"ifade":"مَا أَتَاهُمْ مِنْ","uzunluk":3,"ayetler":["6:4","15:11","21:2","26:5","36:30","36:46","43:7"]},{"ifade":"هُوَ الْحَقُّ مِنْ","uzunluk":3,"ayetler":["8:32"]},{"ifade":"أَمْ يَقُولُونَ افْتَرَاهُ","uzunluk":3,"ayetler":["10:38","11:13","11:35","42:24","46:8"]},{"ifade":"افْتَرَاهُ بَلْ هُوَ","uzunluk":3,"ayetler":["21:5"]},{"ifade":"لِتُنْذِرَ قَوْمًا مَا","uzunluk":3,"ayetler":["36:6"]}],"ortak_ifade_toplam":32,"ortak_ifade_grup":8,"ayni_bolum":{"bolum":1,"ayetler":["32:1","32:2","32:3"]}},"32:4":{"benzer_ifade":[{"not":"التشابه في قوله تعالي {ثُمَّ اسْتَوَى عَلَى الْعَرْشِ}","ayetler":["7:54","10:3","13:2","57:4"]},{"not":"يشبه كثيرًا على الحافظ ختام الآية (تتذكرون) أو (تذكرون) هل هي بالتاء الواحدة أو الاثنتين، وقد جمعت أسماء السور التي تبدأ بالتاءين للمواضع الثلاثة في جملة (سجدت الأنعام للغافر)، وهي كما يلي:\r\n(وَحَاجَّهُ قَوْمُهُ ۚ قَالَ أَتُحَاجُّونِّي فِي اللَّهِ وَقَدْ هَدَانِ ۚ وَلَا أَخَافُ مَا تُشْرِكُونَ بِهِ إِلَّا أَن يَشَاءَ رَبِّي شَيْئًا ۗ وَسِعَ رَبِّي كُلَّ شَيْءٍ عِلْمًا ۗ أَفَلَا تَتَذَكَّرُونَ) الأنعام:٨٠.\r\n(اللَّهُ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ وَمَا بَيْنَهُمَا فِي سِتَّةِ أَيَّامٍ ثُمَّ اسْتَوَىٰ عَلَى الْعَرْشِ ۖ مَا لَكُم مِّن دُونِهِ مِن وَلِيٍّ وَلَا شَفِيعٍ ۚ أَفَلَا تَتَذَكَّرُونَ) السجدة:٤.\r\nوقوله تعالى: (وَمَا يَسْتَوِي الْأَعْمَىٰ وَالْبَصِيرُ وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَلَا الْمُسِيءُ ۚ قَلِيلًا مَّا تَتَذَكَّرُونَ) غافر:٥٨.\r\nوما عداها في ستة مواضع (تذَّكرون) أو (يذَّكرون)، كما في الأنعام ١٢٦، والأعراف ٢٦و١٣٠، والأنفال ٥٧، والتوبة ١٢٦، والنحل ١٣.","ayetler":["40:58","6:80"]},{"not":"(تتذكرن) لم ترد في القرآن إلا في ثلاث مواضع فقط \nوما عداها (تذكرون) تاء واحدة.","ayetler":["6:80","40:58"]},{"not":"(الذي خلق السماوات والأرض وما بينهما)\nوردت (وما بينهما) فقط في سورتي الفرقان والسجدة\nوكل ما في القرآن بدونهما.","ayetler":["25:59"]},{"not":"(الذي خلق السماوات والأرض وما بينهما) \n((بهذا التركيب)) \nورد مرتين فقط في الفرقان والسجدة، وكلتا السورتين فيها سجدة تلاوة.","ayetler":["25:59"]}],"konu":[346,903,2987,341,2986],"ortak_ifade":[{"ifade":"الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ وَمَا بَيْنَهُمَا فِي سِتَّةِ أَيَّامٍ ثُمَّ اسْتَوَىٰ عَلَى الْعَرْشِ","uzunluk":13,"ayetler":["25:59"]},{"ifade":"خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ وَمَا بَيْنَهُمَا فِي سِتَّةِ أَيَّامٍ","uzunluk":8,"ayetler":["50:38"]},{"ifade":"فِي سِتَّةِ أَيَّامٍ ثُمَّ اسْتَوَىٰ عَلَى الْعَرْشِ","uzunluk":7,"ayetler":["7:54","10:3","57:4"]},{"ifade":"اللَّهُ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ","uzunluk":5,"ayetler":["6:1","14:32","17:99","46:33"]},{"ifade":"خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ وَمَا بَيْنَهُمَا","uzunluk":5,"ayetler":["15:85","21:16","38