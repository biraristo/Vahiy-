2:16","32:17","32:18","32:19","32:20","32:21","32:22"]}},"32:20":{"benzer_ifade":[{"not":"التشابه فى قوله تعالى ( عذاب النار )","ayetler":["34:42"]},{"not":"قوله تعالى:﴿ وَأَمَّا الَّذِينَ فَسَقُوا فَمَأْوَاهُمُ النَّارُ ۖ كُلَّمَا أَرَادُوا أَن يَخْرُجُوا مِنْهَا أُعِيدُوا فِيهَا وَقِيلَ لَهُمْ ذُوقُوا عَذَابَ النَّارِ الَّذِي كُنتُم بِهِ تُكَذِّبُونَ﴾ السجدة:20، \nمع قوله تعالى:﴿ فَالْيَوْمَ لَا يَمْلِكُ بَعْضُكُمْ لِبَعْضٍ نَّفْعًا وَلَا ضَرًّا وَنَقُولُ لِلَّذِينَ ظَلَمُوا ذُوقُوا عَذَابَ النَّارِ الَّتِي كُنتُم بِهَا تُكَذِّبُونَ﴾ سبأ: 42.\n\nفالإشكال بين (الَّذِي) و(الَّتِي) اللتان في ختام الآية، والضابط: أن المذكر سابق المؤنث في ترتيب السور وهذا غالب ما في القرآن .","ayetler":["34:42"]},{"not":"في الحج: \" كلما أرادوا أن يخرجوا منها من غم أعيدوا فيها \" \nفي ألم السجدة: \"كلما أرادوا أن يخرجوا منها أعيدوا فيها \"\n\nفي الحج: \"وإنما يدعون من دونه الباطل\"   في لقمان: \"من دونه الباطل\".","ayetler":["22:22","31:30","22:62"]}],"konu":[1826,544,290,411,178,4925,514],"ortak_ifade":[{"ifade":"كُلَّمَا أَرَادُوا أَنْ يَخْرُجُوا مِنْهَا","uzunluk":5,"ayetler":["22:22"]},{"ifade":"ذُوقُوا عَذَابَ النَّارِ الَّذِي كُنْتُمْ","uzunluk":5,"ayetler":["34:42"]},{"ifade":"أَرَادُوا أَنْ يَخْرُجُوا مِنْهَا","uzunluk":4,"ayetler":["5:37"]},{"ifade":"الَّذِي كُنْتُمْ بِهِ تُكَذِّبُونَ","uzunluk":4,"ayetler":["37:21","83:17"]},{"ifade":"الَّذِي كُنْتُمْ بِهِ","uzunluk":3,"ayetler":["51:14","67:27"]},{"ifade":"النَّارِ الَّذِي كُنْتُمْ","uzunluk":3,"ayetler":["52:14"]},{"ifade":"كُنْتُمْ بِهِ تُكَذِّبُونَ","uzunluk":3,"ayetler":["77:29"]}],"ortak_ifade_toplam":9,"ortak_ifade_grup":7,"ayni_bolum":{"bolum":3,"ayetler":["32:10","32:11","32:12","32:13","32:14","32:15","32:16","32:17","32:18","32:19","32:20","32:21","32:22"]}},"32:21":{"ortak_ifade":[{"ifade":"وَلَنُذِيقَنَّهُمْ مِنَ الْعَذَابِ","uzunluk":3,"ayetler":["22:25","34:12","41:50"]}],"ortak_ifade_toplam":3,"ortak_ifade_grup":1,"ayni_bolum":{"bolum":3,"ayetler":["32:10","32:11","32:12","32:13","32:14","32:15","32:16","32:17