ْقَمَرَ كُلٌّ يَجْرِي إِلَىٰ أَجَلٍ مُّسَمًّى وَأَنَّ اللَّهَ بِمَا تَعْمَلُونَ خَبِيرٌ) لقمان:٢٩.\r\nقوله (إلى أجل مسمى) الوحيدة في القرآن، وما عداها (لأجل مسمى) كما في الرعد وفاطر والزمر.","ayetler":["31:29","35:13","39:5"]},{"not":"(وَسَخَّرَ الشَّمْسَ وَالْقَمَرَ كُلٌّ يَجْرِي لِأَجَلٍ مُّسَمًّى)","ayetler":["35:13","39:5"]},{"not":"قال تعالى: - \"وسخَّر الشمس والقمر كُلٌّ يجري لأجلٍ مسمًّى\" [الرعد، فاطر، الزمر] \n\"وسخَّر الشمس والقمر كُلٌّ يجري (إلى) أجلٍ مُسمًّى\" [لقمان] \nكل ما جاء في القرآن \"كلٌّ يجري لأجل مسمًّى\" \nما عدا موضع وحيد في سورة لقمان: \"كلٌّ يجري (إلى) أجل مسمًّى\".","ayetler":["31:29","35:13","39:5"]}],"konu":[3808,2820,3809,2988,2989,3807,2986,2778,3492,134],"ortak_ifade":[{"ifade":"وَسَخَّرَ الشَّمْسَ وَالْقَمَرَ كُلٌّ يَجْرِي لِأَجَلٍ مُسَمًّى","uzunluk":7,"ayetler":["35:13","39:5"]},{"ifade":"وَسَخَّرَ الشَّمْسَ وَالْقَمَرَ كُلٌّ يَجْرِي","uzunluk":5,"ayetler":["31:29"]},{"ifade":"ثُمَّ اسْتَوَىٰ عَلَى الْعَرْشِ","uzunluk":4,"ayetler":["7:54","10:3","25:59","32:4","57:4"]},{"ifade":"السَّمَاوَاتِ بِغَيْرِ عَمَدٍ تَرَوْنَهَا","uzunluk":4,"ayetler":["31:10"]},{"ifade":"لَعَلَّكُمْ بِلِقَاءِ رَبِّكُمْ","uzunluk":3,"ayetler":["6:154"]},{"ifade":"يُفَصِّلُ الْآيَاتِ لَعَلَّكُمْ","uzunluk":3,"ayetler":["7:174"]},{"ifade":"الشَّمْسَ وَالْقَمَرَ كُلٌّ","uzunluk":3,"ayetler":["21:33"]},{"ifade":"وَسَخَّرَ الشَّمْسَ وَالْقَمَرَ","uzunluk":3,"ayetler":["29:61"]}],"ortak_ifade_toplam":13,"ortak_ifade_grup":8,"ayni_bolum":{"bolum":2,"ayetler":["13:2","13:3","13:4"]}},"13:3":{"benzer_ifade":[{"not":"تشابه في قوله تعالى ﴿ إِنَّ فِي ذَلِكَ لَآيَاتٍ لِّقَوْمٍ يَتَفَكَّرُونَ ﴾","ayetler":["16:11","6:99","30:21"]},{"not":"فقد جاء في سورة الرعد والنحل ﴿إِنَّ فِي ذَٰلِكَ لَآيَاتٍ لِّقَوْمٍ يَتَفَكَّرُونَ﴾ قبل ﴿إِنَّ فِي ذَٰلِكَ لَآيَاتٍ لِّقَوْمٍ يَعْقِلُونَ﴾ وهذا محل اتفاق،\n فالربط بين السورتين مما يفيد في ضبط المتشابه  مع ملاحظة أنه قد يأتي (لآية) أو(لآيات).","ayetler":["13:4","16:11","16:12"]}],"konu":[484,3811,126,3810,2674,138,3615,1653,127,2991,327,