٢ – التوبة ١٠٠ – الحديد ١٢ – التغابن ٩.","ayetler":["4:169","72:23"]},{"not":"(خالدين فيها أبداً)\nأتت (أبداً) في 11 موضع من القرآن فقط","ayetler":["4:57","4:122","4:169","5:119","9:22","9:100","64:9","65:11","72:23","98:8"]},{"not":"ورد لفظ ( خالدين فيها ابدا) عن أهل النار ثلاث مرات فقط.","ayetler":["4:169","72:23"]}],"ortak_ifade":[{"ifade":"لَا يَجِدُونَ وَلِيًّا وَلَا نَصِيرًا","uzunluk":5,"ayetler":["48:22"]},{"ifade":"وَلِيًّا وَلَا نَصِيرًا","uzunluk":3,"ayetler":["2:107","2:120","4:89","4:123","4:173","9:74","9:116","29:22","33:17","42:8","42:31"]},{"ifade":"خَالِدِينَ فِيهَا أَبَدًا","uzunluk":3,"ayetler":["4:57","4:122","4:169","5:119","9:22","9:100","64:9","65:11","72:23","98:8"]}],"ortak_ifade_toplam":22,"ortak_ifade_grup":3},"33:66":{"konu":[2960],"ortak_ifade":[{"ifade":"أَطَعْنَا اللَّهَ وَأَطَعْنَا الرَّسُولَا","uzunluk":4,"ayetler":["4:59","5:92","24:54","47:33","64:12"]},{"ifade":"النَّارِ يَقُولُونَ يَا لَيْتَنَا","uzunluk":3,"ayetler":["6:27"]},{"ifade":"وُجُوهُهُمْ فِي النَّارِ","uzunluk":3,"ayetler":["27:90"]},{"ifade":"فِي النَّارِ يَقُولُونَ","uzunluk":3,"ayetler":["40:47"]}],"ortak_ifade_toplam":8,"ortak_ifade_grup":4},"33:67":{"konu":[2240,2960],"ortak_ifade":[{"ifade":"وَقَالُوا رَبَّنَا إِنَّا","uzunluk":3,"ayetler":["3:16","3:36","5:25","11:45","11:47","19:4","20:45","26:12","26:117","27:44","28:16","28:24","28:33","51:30","71:5"]}],"ortak_ifade_toplam":15,"ortak_ifade_grup":1},"33:68":{},"33:69":{"konu":[5013,2718],"ortak_ifade":[{"ifade":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَكُونُوا كَالَّذِينَ","uzunluk":6,"ayetler":["3:156"]},{"ifade":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا","uzunluk":4,"ayetler":["2:104","2:264","3:118","3:130","4:19","4:29","4:43","4:144","5:2","5:51","5:57","5:87","5:95","5:101","8:27","9:23","24:21","24:27","33:53","49:1","49:2","49:11","60:1","60:13","63:9"]},{"ifade":"لَا تَكُونُوا كَالَّذِينَ","uzunluk":3,"ayetler":["3:105","8:21","8:47","16:92","57:16","59:19"]}],"ortak_ifade_toplam":32,"ortak_ifade_grup":3},"33: