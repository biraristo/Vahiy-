nbsp;</p><p><br></p><p>وقال {وَامْرَأَتُهُ حَمَّالَةَ الْحَطَبِ} &nbsp;يقول: \"وَتَصْلَى امرأتُه حمالةِ الحَطَب\" و {حمالةُ الحَطَبِ} من صفتها. ونصب بعضهم {حمّالةَ الحَطَب} على الذم كأنه قال \"ذكرتُها حمالةَ الحطبِ\" ويجوز ان تكون {حمالةَ الحطبِ} نكرة نوى بها التنوين فتكون حالا \"امرأته\" وتنتصب بقوله {تَصْلى}&nbsp;</p>"},{"id":13535,"okuyus":{"2":"ḥammālata"},"okuyanlar":["einige (Grammatiker?, Koranleser?)"],"eser":"al-Aḫfaš al-Ausaṭ (gest. 830): Maʿānī","eser_vefat":"215","kanonik_eser":0,"not":"<p>al-Aḫfaš al-Auṣaṭ, Maʿānī al-qurʾān, edition Hudā Maḥmūd Qurāʿa, Cairo 1990, vol. 2, p. 588:&nbsp;</p><p><br></p><p>وقال {وَامْرَأَتُهُ حَمَّالَةَ الْحَطَبِ} &nbsp;يقول: \"وَتَصْلَى امرأتُه حمالةِ الحَطَب\" و {حمالةُ الحَطَبِ} من صفتها. ونصب بعضهم {حمّالةَ الحَطَب} على الذم كأنه قال \"ذكرتُها حمالةَ الحطبِ\" ويجوز ان تكون {حمالةَ الحطبِ} نكرة نوى بها التنوين فتكون حالا \"امرأته\" وتنتصب بقوله {تَصْلى}&nbsp;</p>"},{"id":13536,"okuyus":{"2":"ḥammālatan"},"okuyanlar":["akzeptable Lesart"],"eser":"al-Aḫfaš al-Ausaṭ (gest. 830): Maʿānī","eser_vefat":"215","kanonik_eser":0,"not":"<p>al-Aḫfaš al-Auṣaṭ, Maʿānī al-qurʾān, edition Hudā Maḥmūd Qurāʿa, Cairo 1990, vol. 2, p. 588:&nbsp;</p><p><br></p><p>وقال {وَامْرَأَتُهُ حَمَّالَةَ الْحَطَبِ} &nbsp;يقول: \"وَتَصْلَى امرأتُه حمالةِ الحَطَب\" و {حمالةُ الحَطَبِ} من صفتها. ونصب بعضهم {حمّالةَ الحَطَب} على الذم كأنه قال \"ذكرتُها حمالةَ الحطبِ\" ويجوز ان تكون {حمالةَ الحطبِ} نكرة نوى بها التنوين فتكون حالا \"امرأته\" وتنتصب بقوله {تَصْلى}</p>"},{"id":16601,"okuyus":{"2":"ḥammālatan"},"okuyanlar":["Abū ʿUbaid"],"eser":"Ibn Ḫālawaih (gest. 981): Muḫtaṣar","eser_vefat":"370","kanonik_eser":0,"not":null}],"qp":[{"kelime":"حَمَّالَةَ","okuyus":"(حَمَّالَةُ) برفع التاء","raviler":[["خلف","حمزة"],["إدريس","خلف"],["إسحاق","خلف"],["روح","يعقوب"],["رويس","يعقوب"],["ابن جمّاز","أبو جعفر"],["ابن وردان","أبو جعفر"],["الدوري","الكسائي"],["أبو الحارث","الكسائي"],["خلاد","حمزة"],["قالون","نافع"],["ابن ذكوان","ابن عامر"],["هشام","ابن عامر"],["السوسي"