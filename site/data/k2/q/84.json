r in Mekka","Anhänger des ʿAbdallāh b. Masʿūd"],"eser":"aṭ-Ṭabarī (gest. 923): Tafsīr","eser_vefat":"310","kanonik_eser":0,"not":null},{"id":11059,"okuyus":{"1":"la-yarkabunna"},"okuyanlar":["unbenannt (ohne nähere Angaben)"],"eser":"aṭ-Ṭabarī (gest. 923): Tafsīr","eser_vefat":"310","kanonik_eser":0,"not":null},{"id":12147,"okuyus":{"1":"la-tarkabunna"},"okuyanlar":["Koranleser in Medina","Lesart aus Kufa"],"eser":"aṭ-Ṭabarī (gest. 923): Tafsīr","eser_vefat":"310","kanonik_eser":0,"not":null},{"id":17476,"okuyus":{"1":"la-tarkabunna"},"okuyanlar":["Referenztext"],"eser":"al-Kalbī (gest. 763): Tafsīr","eser_vefat":"146","kanonik_eser":0,"not":"<p style=\"font-size: 14.000001px;\">Tanwīr al-miqbās min tafsīr Ibn ʿAbbās, edition Beirut 1412/1992, Dār al-kutub al-ʿilmiyya, p. 641:</p><p style=\"font-size: 14.000001px;\"></p><div style=\"font-size: 14.000001px; direction: rtl;\">{لَتَرْكَبُنَّ} لتحولن جملَة الْخلق {طَبَقاً عَن طَبقٍ} حَالا بعد حَال من حِين خلقهمْ إِلَى أَن يموتوا وَمن حِين مَوْتهمْ إِلَى أَن يدخلُوا الْجنَّة أَو النَّار يحولهم الله من حَال إِلَى حَال وَيُقَال لتركبن يَا مُحَمَّد لتصعدن طبقًا عَن طبق يَقُول من سَمَاء إِلَى سَمَاء لَيْلَة الْمِعْرَاج إِن قَرَأت بِنصب الْبَاء وَيُقَال ليركبن هَذَا المكذب طبقًا عَن طبق حَالا بعد حَال من حِين يَمُوت إِلَى أَن يدْخل النَّار إِن قَرَأت بِالْيَاءِ ونصبت الْيَاء</div>"},{"id":17477,"okuyus":{"1":"la-tarkabunna | la-yarkabanna"},"okuyanlar":["unbenannt (ohne nähere Angaben)"],"eser":"al-Kalbī (gest. 763): Tafsīr","eser_vefat":"146","kanonik_eser":0,"not":"<p style=\"font-size: 14.000001px;\">Tanwīr al-miqbās min tafsīr Ibn ʿAbbās, edition Beirut 1412/1992, Dār al-kutub al-ʿilmiyya, p. 641:</p><p style=\"font-size: 14.000001px;\"></p><div style=\"font-size: 14.000001px; direction: rtl;\">{لَتَرْكَبُنَّ} لتحولن جملَة الْخلق {طَبَقاً عَن طَبقٍ} حَالا بعد حَال من حِين خلقهمْ إِلَى أَن يموتوا وَمن حِين مَوْتهمْ إِلَى أَن يدخلُوا الْجنَّة أَو النَّار يحولهم الله من حَال إِلَى حَال وَيُقَال لتركبن يَا مُحَمَّد لتصعدن طبقًا عَن طبق يَقُول من سَمَاء إِلَى سَمَاء لَيْلَة الْمِعْرَاج إِن قَرَأت بِنصب الْبَاء وَيُقَال ليركبن هَذَا المكذب طبقًا عَن طبق حَالا بعد حَال من حِين يَمُوت إِلَى أَن يدْخل النَّار إِن قَرَأت بِالْيَاءِ ونصبت الْيَاء</div>"},{"id":18303,"okuyus":{"1":"la-tarkabunna"},"okuyanlar":["Ibn ʿAbbās"],"eser":"Muǧāhid (gest. 722): Tafsīr","eser_vefat":"100-104","kanonik_eser":0,"not":"<p>Tafsīr Muǧāhid, ed. Abū an-Nīl, p. 716.</p>"}],"qp":[{"kelime":"لَتَرْكَبُنَّ","okuyus":"(لَتَرْكَبُنَّ) بضم الباء","raviler":[["ورش","نافع"],["قالون","نافع"],["الدوري","أبو عمرو"],["السوسي","أبو عمرو"],["هشام","ابن عامر"],["ابن ذكوان","ابن عامر"],["شعبة","عاصم"],["حفص","عاصم"],["روح","يعقوب"],["رويس","يعقوب"],["ابن جمّاز","أبو جعفر"],["ابن وردان","أبو جعفر"]]},{"kelime":"لَتَرْكَبُنَّ","okuyus":"(لَتَرْكَبَنَّ) بفتح الباء","raviler":[["إدريس","خلف"],["إسحاق","خلف"],["الدوري","الكسائي"],["أبو الحارث","الكسائي"],["خلاد","حمزة"],["خلف","حمزة"],["قنبل","ابن كثير"],["البزي","ابن كثير"]]}],"cc_ref":{"1":"لَتَرۡكَبُنَّ","2":"طَبَقًا","3":"عَن","4":"طَبَقٍۢ"}},"84:20":{"cc":[],"qp":[],"cc_ref":{"1":"فَمَا","2":"لَهُمۡ","3":"لَا","4":"يُؤۡمِنُونَ"}},"84:21":{"cc":[{"id":5806,"okuyus":{"4":"l-qurānu"},"okuyanlar":["Ibn Kaṯīr"],"eser":"ad-Dānī (gest. 1053): at-Taisīr","eser_vefat":"444","kanonik_eser":1,"not":null}],"qp":[{"kelime":"الْقُرْءَانُ","okuyus":"(الْقُرْءَانُ) بإسكان الراء وبعدها همزة مفتوحة","raviler":[["قالون","نافع"],["خلاد","حمزة"],["خلف","حمزة"],["أبو الحارث","الكسائي"],["حفص","عاصم"],["الدوري","الكسائي"],["شعبة","عاصم"],["ابن وردان","أبو جعفر"],["ابن ذكوان","ابن عامر"],["ابن جمّاز","أبو جعفر"],["هشام","ابن عامر"],["السوسي","أبو عمرو"],["رويس","يعقوب"],["الدوري","أبو عمرو"],["روح","يعقوب"],["ورش","نافع"],["إدريس","خلف"],["إسحاق","خلف"]]},{"kelime":"الْقُرْءَانُ","okuyus":"(الْقُرَانُ) بفتح الراء وحذف الهمزة","raviler":[["قنبل","ابن كثير"],["البزي","ابن كثير"]]},{"kelime":"عَلَيْهِمُ","okuyus":"(عَلَيْهُمُ) بضم الهاء والميم","raviler":[["الدوري","الكسائي"],["خلف","حمزة"],["إدريس","خلف