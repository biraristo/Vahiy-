at":"215","kanonik_eser":0,"not":"<p>al-Aḫfaš al-Auṣaṭ, Maʿānī al-qurʾān, edition Hudā Maḥmūd Qurāʿa, Cairo 1990, vol. 1, p. 41-42:&nbsp;</p><p><br></p><p>ناس من العرب يميلون ما كان من هذا النحو وهم بعض اهل الحجاز ويقولون ايضاً {وَلِمَنْ خِافَ مَقَامَ رَبِّهِ} و {فَانكِحُواْ مَا طِابَ لَكُمْ مِّنَ النِّسَآءِ} [و] {وَقَدْ خِابَ} ولايقولون {قِال} ولا (زِار) لانه يقول (قُلْتُ) و (زُرْتُ) فأوله مضموم. فانما يفعلون هذا في ما كان اوله من \"فعلتُ\" مكسوراً إلاَّ أنَّهم ينحون الكسرة كما &nbsp;ينحون الياء في قوله {وَسَقِاهُمْ رَبُّهُمْ} . و {قَدْ أَفْلَحَ مَن زَكَّاهَا} . ويقرأ جميع ذلك بالتفخيم. وما كان من نحو هذا من بنات الواو وكان ثالثاً نحو {وَالْقَمَرِ إِذَا تَلاَهَا} ونحو {وَالأَرْضِ وَمَا طَحَاهَا} . فان كثيراً من العرب يفخمه ولا يميله لانها ليست بياء فتميل اليها لانها من \"طَحَوْتُ\" و \"تَلَوْتُ\". فاذا كانت رابعة فصاعداً أمالوا وكانت الامالة هي الوجه، لانها حينئذ قد انقلبت الى الياء. الا ترى انك تقول \"غَزَوْتُ\" و \"أَغْزَيْتُ\" ومثل ذلك {وَاللَّيْلِ إِذَا يَغْشَاهَا} . و {قَدْ أَفْلَحَ مَن تَزَكَّى} و {وَالنَّهَارِ إِذَا تَجَلَّى} أمالَها لأنَّها رابعة, و \"تَجَلّى\" فَعلْتُ منها بالواو لأنها من \"جَلَوْت\" و \"زكا\" من \"زَكَوْتُ يزكو\" و {وَاللَّيْلِ إِذَا يَغْشَاهَا} من \"الغشاوة\". وقد يميل ما كان منه بالواو نحو (تَلاِها) و (طَحِاها) ناسٌ كثير، لأنَّ الواو تنقلب الى الياء كثيرا مثل قولهم في (حُور) (حِير) وفي \"مَشُوب\" \"مَشِيب\" وقالوا \"أَرْضٌ مَسْنِيّة\" اذا كان يسنوها المطر. فأمالوها الى الياء لانها تنقلب اليها. وأمالوا كل ما كان نحو \"فَعْلى\" و \"فُعْلى\" نحو \"بُشْرى\" و \"مَرْضى\" و \"سَكْرى\"، لان هذا لَوْثُنِّيَ كان بالياء فمالوا اليها.</p>"},{"id":13690,"okuyus":{"3":"ṭaḥiāhā"},"okuyanlar":["Einige Leute"],"eser":"al-Aḫfaš al-Ausaṭ (gest. 830): Maʿānī","eser_vefat":"215","kanonik_eser":0,"not":"<p>al-Aḫfaš al-Auṣaṭ, Maʿānī al-qurʾān, edition Hudā Maḥmūd Qurāʿa, Cairo 1990, vol. 1, p. 41-42:&nbsp;</p><p><br></p><p>ناس من العرب يميلون ما كان من هذا النحو وهم بعض اهل الحجاز ويقولون ايضاً {وَلِمَنْ خِافَ مَقَامَ رَبِّهِ} و {فَانكِحُواْ مَا طِابَ لَكُمْ مِّنَ النِّسَآءِ} [و] {وَقَدْ خِابَ} ولايقولون {قِال} ولا (زِار) لانه يقول (قُلْتُ) و (زُرْتُ) فأوله مضموم. فانما يفعلون هذا في ما كان اوله من \"فعلتُ\" مكسوراً إلاَّ أنَّهم ينحون الكسرة كما &nbsp;ينحون الياء في قوله {وَسَقِاهُمْ رَبُّهُمْ} . و {قَدْ أَفْلَحَ مَن زَكَّاهَا} . ويقرأ جميع ذلك بالتفخيم. وما كان من نحو هذا من بنات الواو وكان ثالثاً نحو {وَالْقَمَرِ إِذَا تَلاَهَا} ونحو {وَالأَرْضِ وَمَا طَحَاهَا} . فان كثيراً من العرب يفخمه ولا يميله لانها ليست بياء فتميل اليها لانها من \"طَحَوْتُ\" و \"تَلَوْتُ\". فاذا كانت رابعة فصاعداً أمالوا وكانت الامالة هي الوجه، لانها حينئذ قد انقلبت الى الياء. الا ترى انك تقول \"غَزَوْتُ\" و \"أَغْزَيْتُ\" ومثل ذلك {وَاللَّيْلِ إِذَا يَغْشَاهَا} . و {قَدْ أَفْلَحَ مَن تَزَكَّى} و {وَالنَّهَارِ إِذَا تَجَلَّى} أمالَها لأنَّها رابعة, و \"تَجَلّى\" فَعلْتُ منها بالواو لأنها من \"جَلَوْت\" و \"زكا\" من \"زَكَوْتُ يزكو\" و {وَاللَّيْلِ إِذَا يَغْشَاهَا} من \"الغشاوة\". وقد يميل ما كان منه بالواو نحو (تَلاِها) و (طَحِاها) ناسٌ كثير، لأنَّ الواو تنقلب الى الياء كثيرا مثل قولهم في (حُور) (حِير) وفي \"مَشُوب\" \"مَشِيب\" وقالوا \"أَرْضٌ مَسْنِيّة\" اذا كان يسنوها المطر. فأمالوها الى الياء لانها تنقلب اليها. وأمالوا كل ما كان نحو \"فَعْلى\" و \"فُعْلى\" نحو \"بُشْرى\" و \"مَرْضى\" و \"سَكْرى\"، لان هذا لَوْثُنِّيَ كان بالياء فمالوا اليها.</p>"}],"qp":[{"kelime":"طَحَاهَا","okuyus":"إمالة الألف","raviler":[["الدوري","الكسائي"],["أبو الحارث","الكسائي"]]},{"kelime":"طَحَاهَا","okuyus":"تقليل الألف","raviler":[["ورش","نافع"],["الدوري","أبو عمرو"],["السوسي","أبو عمرو"]]},{"kelime":"طَحَاهَا","okuyus":"فتح الألف","raviler":[["إدريس","خلف"],["قالون","نافع"],["إسحاق","خلف"],["روح","يعقوب"],["رويس","يعقوب"],["ابن جمّاز","أبو جعفر"],["ابن وردان","أبو جعفر"],["خلاد","حمزة"],["خلف","حمزة"],["حفص","عاصم"],["شعبة","عاصم"],["ابن ذكوان","ابن عامر"],["هشام","ابن عامر"],["قنبل","ابن كثير"],["البزي","ابن كثير"],["ورش","نافع"]]}],"cc_ref":{"1":"وَٱلۡأَرۡضِ","2":"وَمَا","3":"طَحَىٰهَا"}},"91:7":{"cc":[{"id":1595,"okuyus":{"2":"wa-man","3":"sawwāhā"},"okuyanl