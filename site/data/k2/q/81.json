َلَى الْغَيْبِ بِضَنِينٍ} يقول \"أي: ببخيل\" وقال بعضهم {بِظَنين} أي: بمتَّهَم لأن بعضَ العربِ يقول \"ظننت زيدا\" فـ\"هو ظنين\" أي: اتَّهَمْتهُ فـ\"هو مُتَّهَم\"</p>"},{"id":13514,"okuyus":{"5":"bi-ẓanīnin"},"okuyanlar":["Lesart der Beduinen","einige (Grammatiker?, Koranleser?)"],"eser":"al-Aḫfaš al-Ausaṭ (gest. 830): Maʿānī","eser_vefat":"215","kanonik_eser":0,"not":"<p>al-Aḫfaš al-Auṣaṭ, Maʿānī al-qurʾān, edition Hudā Maḥmūd Qurāʿa, Cairo 1990, vol. 2, p. 569:&nbsp;</p><p><br></p><p>.وقال {وَمَا هُوَ عَلَى الْغَيْبِ بِضَنِينٍ} يقول \"أي: ببخيل\" وقال بعضهم {بِظَنين} أي: بمتَّهَم لأن بعضَ العربِ يقول \"ظننت زيدا\" فـ\"هو ظنين\" أي: اتَّهَمْتهُ فـ\"هو مُتَّهَم\"</p>"},{"id":15177,"okuyus":{"5":"bi-ḍanīnin"},"okuyanlar":["Ibn ʿAbbās"],"eser":"ʿAbdarrazzāq (gest. 827): Tafsīr","eser_vefat":"211","kanonik_eser":0,"not":"<p>ʿAbdarrazzāq aṣ-Ṣanʿānī, Tafsīr al-qurʾān, Muṣṭafā Muslim Muḥammad (ed.), Riad 1989, vol. 2, p. 353:</p><p><br></p><p>عبد الرزاق عن ابن التيمي عن مغيرة عن مجاهد قال سمعت ابن الزبير يقرؤها وما هو عن الغيب بظنين فسألت ابن عباس فقال ضنين قال وكان ابن مسعود يقرؤها ضنين قال مغيرة وقال إبراهيم الظنين المتهم والضنين البخيل عبد الرزاق عن ابن أبي يحيى عن إسحاق بن عبد الله ابن أبي فروة عن ابن الزبير أن النبي كان يقرؤها وما هو عن الغيب بظنين&nbsp;</p><div><br></div>"},{"id":15178,"okuyus":{"5":"bi-ẓanīnin"},"okuyanlar":["Ibn Masʿūd","der Prophet","Ibn az-Zubair"],"eser":"ʿAbdarrazzāq (gest. 827): Tafsīr","eser_vefat":"211","kanonik_eser":0,"not":"<p>ʿAbdarrazzāq aṣ-Ṣanʿānī, Tafsīr al-qurʾān, Muṣṭafā Muslim Muḥammad (ed.), Riad 1989, vol. 2, p. 353:</p><p><br></p><p>عبد الرزاق عن ابن التيمي عن مغيرة عن مجاهد قال سمعت ابن الزبير يقرؤها وما هو عن الغيب بظنين فسألت ابن عباس فقال ضنين قال وكان ابن مسعود يقرؤها ضنين قال مغيرة وقال إبراهيم الظنين المتهم والضنين البخيل عبد الرزاق عن ابن أبي يحيى عن إسحاق بن عبد الله ابن أبي فروة عن ابن الزبير أن النبي كان يقرؤها وما هو عن الغيب بظنين&nbsp;</p><div><br></div>"},{"id":17474,"okuyus":{"5":"bi-ẓanīnin"},"okuyanlar":["Referenztext"],"eser":"al-Kalbī (gest. 763): Tafsīr","eser_vefat":"146","kanonik_eser":0,"not":"<p style=\"font-size: 14.000001px;\">Tanwīr al-miqbās min tafsīr Ibn ʿAbbās, edition Beirut 1412/1992, Dār al-kutub al-ʿilmiyya, p. 637:</p><p style=\"font-size: 14.000001px;\"></p><div style=\"font-size: 14.000001px; direction: rtl;\">{بِضَنِينٍ} بمتهم وَيُقَال ببخيل إِن قَرَأت بالضاد</div>"},{"id":17475,"okuyus":{"5":"bi-ḍanīnin"},"okuyanlar":["unbenannt (ohne nähere Angaben)"],"eser":"al-Kalbī (gest. 763): Tafsīr","eser_vefat":"146","kanonik_eser":0,"not":"<p style=\"font-size: 14.000001px;\">Tanwīr al-miqbās min tafsīr Ibn ʿAbbās, edition Beirut 1412/1992, Dār al-kutub al-ʿilmiyya, p. 637:</p><p style=\"font-size: 14.000001px;\"></p><div style=\"font-size: 14.000001px; direction: rtl;\">{بِضَنِينٍ} بمتهم وَيُقَال ببخيل إِن قَرَأت بالضاد</div>"}],"qp":[{"kelime":"الْغَيْبِ بِضَنِينٍ وَمَا","okuyus":"(الْغَيْبِ بِضَنِينٍ وَمَا) اظهار الباء الأولى مكسورة وبالضاد بدل الظاء وبإدغام التنوين في الواو بغنة","raviler":[["ورش","نافع"],["إدريس","خلف"],["إسحاق","خلف"],["روح","يعقوب"],["ابن جمّاز","أبو جعفر"],["ابن وردان","أبو جعفر"],["خلاد","حمزة"],["حفص","عاصم"],["شعبة","عاصم"],["ابن ذكوان","ابن عامر"],["هشام","ابن عامر"],["قالون","نافع"]]},{"kelime":"الْغَيْبِ بِضَنِينٍ وَمَا","okuyus":"(الغَيْبِ بِضَنِينٍ وَمَا) اظهار الباء الأولى مكسورة وبالضاد بدل الظاء وبإدغام التنوين في الواو بلا غنة","raviler":[["خلف","حمزة"]]},{"kelime":"الْغَيْبِ بِضَنِينٍ وَمَا","okuyus":"(الغَيْب بِّظَنِينٍ وَمَا) ادغام الباء في الباء وبالظاء بدل الضاد وادغام التنوين في الواو بغنة","raviler":[["السوسي","أبو عمرو"]]},{"kelime":"الْغَيْبِ بِضَنِينٍ وَمَا","okuyus":"(الْغَيْبِ بِظَنِينٍ وَمَا) اظهار الباء الأولى مكسورة وبالظاء بدل الضاد وبإدغام التنوين في الواو بغنة","raviler":[["أبو الحارث","الكسائي"],["الدوري","الكسائي"],["الدوري","أبو عمرو"],["رويس","يعقوب"],["قنبل","ابن كثير"],["البزي","ابن كثير"]]}],"cc_ref":{"1":"وَمَا","2":"هُوَ","3":"عَلَى","4":"ٱلۡغَيۡبِ","5":"بِضَنِينٍۢ"}},"81:25":{"cc":[],"qp":[],"