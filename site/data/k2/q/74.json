tisʿatu","3":"ʿšara"},"okuyanlar":["Abū Ḥātim as-Siǧistānī"],"eser":"Ibn Ḫālawaih (gest. 981): Muḫtaṣar","eser_vefat":"370","kanonik_eser":0,"not":null},{"id":10673,"okuyus":{"3":"ʿšara"},"okuyanlar":["grammatisch möglich"],"eser":"al-Farrāʾ (gest. 822): Maʿānī","eser_vefat":"207","kanonik_eser":0,"not":null},{"id":12228,"okuyus":{"1":"ʿalaihā","2":"tisʿata","3":"ʿašara"},"okuyanlar":["allgemein übliche Lesart"],"eser":"al-Farrāʾ (gest. 822): Maʿānī","eser_vefat":"207","kanonik_eser":0,"not":null},{"id":14146,"okuyus":{"3":"ʿašara"},"okuyanlar":["Referenztext"],"eser":"al-Aḫfaš al-Ausaṭ (gest. 830): Maʿānī","eser_vefat":"215","kanonik_eser":0,"not":"<p>al-Aḫfaš al-Auṣaṭ, Maʿānī al-qurʾān, edition Hudā Maḥmūd Qurāʿa, Cairo 1990, vol. 1, p. 394:&nbsp;</p><p><br></p><p>وقال {إِنِّي رَأَيْتُ أَحَدَ عَشَرَ كَوْكَباً وَالشَّمْسَ وَالْقَمَرَ رَأَيْتُهُمْ لِي سَاجِدِينَ} فكرر الفعل وقد يستغني باحدهما. وهذا على لغة الذين قالوا \"ضَرَبْتُ ز َيْداً ضَرَبْتُهُ\" وهو توكيد مثل {فَسَجَدَ الْمَلاَئِكَةُ كُلُّهُمْ أَجْمَعُونَ} وقال بعضهم (أَحَدَ عْشَرَ) واسكن العين وكذلك (تِسْعَةَ عْشَرَ) الى العشرين لما طال الاسم وكثرت متحركاته اسكنوا. ولم يسكنوا في قولهم \"اثْنَيْ عَشَر\" و\"اثْنَتا عَشْرَةَ\" للحرف الساكن الذي قبل العين وحركة العين في هذا كله هو الاصل.</p>"},{"id":14147,"okuyus":{"3":"ʿšara"},"okuyanlar":["einige (Grammatiker?, Koranleser?)"],"eser":"al-Aḫfaš al-Ausaṭ (gest. 830): Maʿānī","eser_vefat":"215","kanonik_eser":0,"not":"<p>al-Aḫfaš al-Auṣaṭ, Maʿānī al-qurʾān, edition Hudā Maḥmūd Qurāʿa, Cairo 1990, vol. 1, p. 394:&nbsp;</p><p><br></p><p>وقال {إِنِّي رَأَيْتُ أَحَدَ عَشَرَ كَوْكَباً وَالشَّمْسَ وَالْقَمَرَ رَأَيْتُهُمْ لِي سَاجِدِينَ} فكرر الفعل وقد يستغني باحدهما. وهذا على لغة الذين قالوا \"ضَرَبْتُ ز َيْداً ضَرَبْتُهُ\" وهو توكيد مثل {فَسَجَدَ الْمَلاَئِكَةُ كُلُّهُمْ أَجْمَعُونَ} وقال بعضهم (أَحَدَ عْشَرَ) واسكن العين وكذلك (تِسْعَةَ عْشَرَ) الى العشرين لما طال الاسم وكثرت متحركاته اسكنوا. ولم يسكنوا في قولهم \"اثْنَيْ عَشَر\" و\"اثْنَتا عَشْرَةَ\" للحرف الساكن الذي قبل العين وحركة العين في هذا كله هو الاصل.</p>"}],"qp":[{"kelime":"تِسْعَةَ عَشَرَ","okuyus":"(تِسْعَةَ عْشَرَ) اسكان العين الثانية","raviler":[["ابن جمّاز","أبو جعفر"],["ابن وردان","أبو جعفر"]]},{"kelime":"تِسْعَةَ عَشَرَ","okuyus":"(تِسْعَةَ عَشَرَ) بفتح العين الثانية","raviler":[["خلف","حمزة"],["إدريس","خلف"],["إسحاق","خلف"],["روح","يعقوب"],["رويس","يعقوب"],["الدوري","الكسائي"],["أبو الحارث","الكسائي"],["خلاد","حمزة"],["قالون","نافع"],["حفص","عاصم"],["شعبة","عاصم"],["ابن ذكوان","ابن عامر"],["هشام","ابن عامر"],["السوسي","أبو عمرو"],["الدوري","أبو عمرو"],["قنبل","ابن كثير"],["البزي","ابن كثير"],["ورش","نافع"]]}],"cc_ref":{"1":"عَلَيۡهَا","2":"تِسۡعَةَ","3":"عَشَرَ"}},"74:31":{"cc":[],"qp":[{"kelime":"النَّارِ","okuyus":"إمالة الألف","raviler":[["الدوري","الكسائي"],["الدوري","أبو عمرو"],["السوسي","أبو عمرو"]]},{"kelime":"النَّارِ","okuyus":"تقليل الألف","raviler":[["ورش","نافع"]]},{"kelime":"النَّارِ","okuyus":"فتح الألف","raviler":[["روح","يعقوب"],["ابن وردان","أبو جعفر"],["أبو الحارث","الكسائي"],["خلاد","حمزة"],["ابن جمّاز","أبو جعفر"],["خلف","حمزة"],["حفص","عاصم"],["رويس","يعقوب"],["شعبة","عاصم"],["ابن ذكوان","ابن عامر"],["هشام","ابن عامر"],["إسحاق","خلف"],["قنبل","ابن كثير"],["البزي","ابن كثير"],["إدريس","خلف"],["قالون","نافع"]]},{"kelime":"هُوَ وَمَا","okuyus":"ادغام الواو في الواو ادغاماً كبيراً","raviler":[["السوسي","أبو عمرو"]]},{"kelime":"هُوَ وَمَا","okuyus":"اظهار الواو الأولى مفتوحة","raviler":[["إدريس","خلف"],["رويس","يعقوب"],["روح","يعقوب"],["ابن جمّاز","أبو جعفر"],["إسحاق","خلف"],["ابن وردان","أبو جعفر"],["الدوري","الكسائي"],["أبو الحارث","الكسائي"],["خلاد","حمزة"],["خلف","حمزة"],["حفص","عاصم"],["شعبة","عاصم"],["ابن ذكوان","ابن عامر"],["هشام","ابن عامر"],["الدوري","أبو عمرو"],["قنبل","ابن كثير"],["البزي","ابن كثير"],["ورش","نافع"],["قالون","نافع"]]}],"cc_ref":{"1":"وَمَا","2":"جَعَلۡنَآ","3":"أَصۡحَٰبَ","4":"ٱلنَّارِ","5":"إِلَّا","6":"مَلَٰٓئِكَةًۭ","7":"وَمَا","8":"جَعَلۡنَا","9":"عِدَّتَهُمۡ","10":"إِلَّا","11":"فِتۡنَةًۭ","12":"لِّلَّذِينَ","13":