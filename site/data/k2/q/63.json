لى موضع {فَأَصَّدَّقَ} لأنَّ جواب الاستفهام اذا لم يكن فيه فاء جزم. وقد قرأ بعضهم {فَأَصَّدَّقَ وَأَكُونَ} عطفها على ما بعد الفاء وذلك خلاف الكتاب.</p><div><br></div>"},{"id":18066,"okuyus":{"19":"ʾakūna"},"okuyanlar":["Ibn Masʿūd","grammatisch korrekte Lesart","Einige Koranleser"],"eser":"al-Farrāʾ (gest. 822): Maʿānī","eser_vefat":"207","kanonik_eser":0,"not":null},{"id":18095,"okuyus":{"18":"fa-ʾaṣṣaddaqa","19":"wa-ʾakun"},"okuyanlar":["Referenztext"],"eser":"Sībawaih (gest. 796): al-Kitāb","eser_vefat":"180 AH, Angaben über sein Todesjahr schwanken zwischen 160 und 194","kanonik_eser":0,"not":null}],"qp":[{"kelime":"فَيَقُولَ رَبِّ","okuyus":"ادغام اللام في الراء إدغاماً كبيراً","raviler":[["السوسي","أبو عمرو"]]},{"kelime":"فَيَقُولَ رَبِّ","okuyus":"اظهار اللام مفتوحة","raviler":[["قالون","نافع"],["الدوري","الكسائي"],["أبو الحارث","الكسائي"],["ابن وردان","أبو جعفر"],["خلاد","حمزة"],["خلف","حمزة"],["ابن جمّاز","أبو جعفر"],["حفص","عاصم"],["شعبة","عاصم"],["رويس","يعقوب"],["ابن ذكوان","ابن عامر"],["هشام","ابن عامر"],["روح","يعقوب"],["الدوري","أبو عمرو"],["إسحاق","خلف"],["قنبل","ابن كثير"],["البزي","ابن كثير"],["إدريس","خلف"],["ورش","نافع"]]},{"kelime":"وَأَكُن","okuyus":"(وَأَكُنْ) بنون ساكنة بعد الكاف وبحذف الواو بينهما","raviler":[["رويس","يعقوب"],["روح","يعقوب"],["ابن جمّاز","أبو جعفر"],["إسحاق","خلف"],["ابن وردان","أبو جعفر"],["الدوري","الكسائي"],["إدريس","خلف"],["أبو الحارث","الكسائي"],["خلاد","حمزة"],["خلف","حمزة"],["حفص","عاصم"],["شعبة","عاصم"],["ابن ذكوان","ابن عامر"],["هشام","ابن عامر"],["قنبل","ابن كثير"],["البزي","ابن كثير"],["ورش","نافع"],["قالون","نافع"]]},{"kelime":"وَأَكُن","okuyus":"(وَأَكُونَ) بواو ساكنة بعد الكاف وبعدها نون مفتوحة","raviler":[["السوسي","أبو عمرو"],["الدوري","أبو عمرو"]]}],"cc_ref":{"1":"وَأَنفِقُوا۟","2":"مِن","3":"مَّا","4":"رَزَقۡنَٰكُم","5":"مِّن","6":"قَبۡلِ","7":"أَن","8":"يَأۡتِیَ","9":"أَحَدَكُمُ","10":"ٱلۡمَوۡتُ","11":"فَيَقُولَ","12":"رَبِّ","13":"لَوۡلَآ","14":"أَخَّرۡتَنِیٓ","15":"إِلَىٰۤ","16":"أَجَلٍۢ","17":"قَرِيبٍۢ"