at":"370","kanonik_eser":0,"not":null},{"id":10620,"okuyus":{"8":"ṯulṯayi","7":"min","9":"l-laili"},"okuyanlar":["Ibn ʿĀmir"],"eser":"Ibn Ḫālawaih (gest. 981): Muḫtaṣar","eser_vefat":"370","kanonik_eser":0,"not":null},{"id":10621,"okuyus":{"69":"ḫairun","70":"wa-ʾaʿẓamu"},"okuyanlar":["Abū as-Sammāl"],"eser":"Ibn Ḫālawaih (gest. 981): Muḫtaṣar","eser_vefat":"370","kanonik_eser":0,"not":null},{"id":10664,"okuyus":{"10":"wa-niṣfahū","11":"wa-ṯuluṯahū"},"okuyanlar":["ʿĀṣim","al-Aʿmaš"],"eser":"al-Farrāʾ (gest. 822): Maʿānī","eser_vefat":"207","kanonik_eser":0,"not":null},{"id":10665,"okuyus":{"10":"wa-niṣfihī","11":"wa-ṯuluṯihī"},"okuyanlar":["al-Ḥasan al-Baṣrī","Lesart der Leute aus Medina"],"eser":"al-Farrāʾ (gest. 822): Maʿānī","eser_vefat":"207","kanonik_eser":0,"not":null},{"id":11934,"okuyus":{"10":"wa-niṣfahū","11":"wa-ṯuluṯahū"},"okuyanlar":["Koranleser in Kufa","Lesart aus Mekka"],"eser":"aṭ-Ṭabarī (gest. 923): Tafsīr","eser_vefat":"310","kanonik_eser":0,"not":null},{"id":13487,"okuyus":{"10":"wa-niṣfahū","11":"wa-ṯuluṯahū"},"okuyanlar":["Referenztext"],"eser":"al-Aḫfaš al-Ausaṭ (gest. 830): Maʿānī","eser_vefat":"215","kanonik_eser":0,"not":"<p>al-Aḫfaš al-Auṣaṭ, Maʿānī al-qurʾān, edition Hudā Maḥmūd Qurāʿa, Cairo 1990, vol. 2, p. 553-554:&nbsp;</p><p><br></p><p>وقال {أَدْنَى مِن ثُلُثَيِ الْلَّيْلِ وَنِصْفَهُ وَثُلُثِهُ} وقد قرئت بالجر وهو كثير وليس المعنى عليه فيما بلغنا لأن ذلك يكون على \"أَدْنَى من نِصْفِهِ\" و\"أَدْنَى من ثُلُثِهِ\" وكان الذي افترض الثلث او اكثر من الثلث لأنه قال {قُمِ الْلَّيْلَ إِلاَّ قَلِيلاً} &nbsp;{نِّصْفَهُ أَوِ انقُصْ مِنْهُ قَلِيلاً} وأما الذي قرأ بالجرّ فقراءته جائزة على ان يكون ذلك - والله أعلم - اي انكم لم تؤدوا ما افترض عليكم فقمتم أدنى من ثلثي الليل ومن نصفه ومن ثلثه.</p>"},{"id":13488,"okuyus":{"10":"wa-niṣfihi","11":"wa-ṯuluṯihi"},"okuyanlar":["unbenannt (ohne nähere Angaben)"],"eser":"al-Aḫfaš al-Ausaṭ (gest. 830): Maʿānī","eser_vefat":"215","kanonik_eser":0,"not":"<p>وقال {أَدْنَى مِن ثُلُثَيِ الْلَّيْلِ وَنِصْفَهُ وَثُلُثِهُ} وقد قرئت بالجر وهو كثير وليس المعنى عليه فيما بلغنا لأن ذلك يكون على \"أَدْنَى من نِصْفِهِ\" و\"أَدْنَى من ثُلُثِهِ\" وكان الذي افترض الثلث او اكثر من الثلث لأنه قال {قُمِ الْلَّيْلَ إِلاَّ قَلِيلاً} &nbsp;{نِّصْفَهُ أَوِ انقُصْ مِنْهُ قَلِيلاً} وأما الذي قرأ بالجرّ فقراءته جائزة على ان يكون ذلك - والله أعلم - اي انكم لم تؤدوا ما افترض عليكم فقمتم أدنى من ثلثي الليل ومن نصفه ومن ثلثه</p><div><br></div>"},{"id":14894,"okuyus":{"69":"ḫairan","70":"wa-ʾaʿẓama"},"okuyanlar":["allgemein übliche Lesart"],"eser":"aṭ-Ṭabarī (gest. 923): Tafsīr","eser_vefat":"310","kanonik_eser":0,"not":null},{"id":14895,"okuyus":{"69":"ḫairun","70":"wa-ʾaʿẓamu"},"okuyanlar":["Wortform des Stammes Tamīm"],"eser":"aṭ-Ṭabarī (gest. 923): Tafsīr","eser_vefat":"310","kanonik_eser":0,"not":null},{"id":17467,"okuyus":{"10":"wa-niṣfahū","11":"wa-ṯuluṯahū"},"okuyanlar":["Referenztext"],"eser":"al-Kalbī (gest. 763): Tafsīr","eser_vefat":"146","kanonik_eser":0,"not":"<p style=\"font-size: 14.000001px;\">Tanwīr al-miqbās min tafsīr Ibn ʿAbbās, edition Beirut 1412/1992, Dār al-kutub al-ʿilmiyya, p. 622:</p><p style=\"font-size: 14.000001px;\"></p><p style=\"font-size: 14.000001px;\"></p><p style=\"font-size: 14.000001px;\"></p><p style=\"font-size: 14.000001px;\"></p><div style=\"font-size: 14.000001px; direction: rtl;\">{مِن ثُلُثَيِ اللَّيْل} إِلَى النّصْف {وَنِصْفَهُ} وَتقوم نصف اللَّيْل {وَثُلُثَهُ} وَتقوم ثلث اللَّيْل وَيُقَال وَنصفه أقل من نصف اللَّيْل وَثلثه إِذا قَرَأت بالخفض</div>"},{"id":17468,"okuyus":{"10":"wa-niṣfihī","11":"wa-ṯuluṯihī"},"okuyanlar":["unbenannt (ohne nähere Angaben)"],"eser":"al-Kalbī (gest. 763): Tafsīr","eser_vefat":"146","kanonik_eser":0,"not":"<p style=\"font-size: 14.000001px;\">Tanwīr al-miqbās min tafsīr Ibn ʿAbbās, edition Beirut 1412/1992, Dār al-kutub al-ʿilmiyya, p. 622:</p><p style=\"font-size: 14.000001px;\"></p><p style=\"font-size: 14.000001px;\"></p><p style=\"font-size: 14.000001px;\"></p><p style=\"font-size: 14.000001px;\"></p><div style=\"font-size: 14.000001px; direction: rtl;\">{مِن ثُلُثَيِ اللَّيْل} إِلَى النّصْف {وَنِصْفَهُ} وَتقوم نصف اللَّيْل {وَثُلُثَهُ} وَتقوم ثلث اللَّيْل وَيُقَال وَنصفه أقل من نصف اللَّيْل وَثلثه إِذا قَرَأت بالخفض</div>"}],"qp":[{"kelime":"الْقُرْءَانِ","okuyus":"(القُرْءَانِ) بإسكان الراء وبعدها همزة مفتوحة","raviler":[["الدوري","أبو عمرو"],["شعبة","عاصم"],["حفص","عاصم"],["خلف","حمزة"],["ابن ذكوان","ابن عامر"],["خلاد","حمزة"],["هشام","ابن عامر"],["أبو الحارث","الكسائي"],["السوسي","أبو عمرو"],["الدوري","الكسائي"],["ابن وردان","أبو جعفر"],["ابن جمّاز","أبو جعفر"],["قالون","نافع"],["رويس","يعقوب"],["إدريس","خلف"],["ورش","نافع"],["روح","يعقوب"],["إسحاق","خلف"]]},{"kelime":"الْقُرْءَانِ","okuyus":"(القُرَانِ) بفتح الراء وحذف الهمزة","raviler":[["البزي","ابن كثير"],["قنبل","ابن كثير"]]},{"kelime":"اللهِ هُوَ","okuyus":"ادغام الهاء في الهاء ادغاماً كبيراً","raviler":[["السوسي","أبو عمرو"]]},{"kelime":"اللهِ هُوَ","okuyus":"اظهار الهاء الأولى مكسورة","raviler":[["أبو الحارث","الكسائي"],["إدريس","خلف"],["حفص","عاصم"],["خلف","حمزة"],["إسحاق","خلف"],["خلاد","حمزة"],["روح","يعقوب"],["الدوري","الكسائي"],["رويس","يعقوب"],["قالون","نافع"],["ابن وردان","أبو جعفر"],["ابن جمّاز","أبو جعفر"],["شعبة","عاصم"],["الدوري","أبو عمرو"],["ورش","نافع"],["ابن ذكوان","ابن عامر"],["قنبل","ابن كثير"],["البزي","ابن كثير"],["هشام","ابن عامر"]]},{"kelime":"ثُلُثَىِ","okuyus":"(ثُلْثَىِ) بإسكان اللام","raviler":[["هشام","ابن عامر"]]},{"kelime":"ثُلُثَىِ","okuyus":"(ثُلُثَىِ) بضم اللام","raviler":[["الدوري","الكسائي"],["شعبة","عاصم"],["ابن وردان","أبو جعفر"],["قنبل","ابن كثير"],["ابن جمّاز","أبو جعفر"],["البزي","ابن كثير"],["رويس","يعقوب"],["روح","يعقوب"],["ورش","نافع"],["إسحاق","خلف"],["قالون","نافع"],["إدريس","خلف"],["ابن ذكوان","ابن عامر"],["أبو الحارث","الكسائي"],["حفص","عاصم"],["السوسي","أبو عمرو"],["خلف","حمزة"],["الدوري","أبو عمرو"],["خلاد","حمزة"]]},{"kelime":"وَنِصْفَهُ وَثُلُثَهُ","okuyus":"(وَنِصْفَهُ وَثُلُثَهُ) بفتح الفاء وضم الهاء وبفتح الثاء الثانية وضم الهاء","raviler":[["خلف","حمزة"],["إدريس","خلف"]