aǧri"},"okuyanlar":["Ḫalaf"],"eser":"Ibn al-Ǧazarī (gest. 1429): an-Našr","eser_vefat":"833","kanonik_eser":0,"not":null},{"id":1085,"okuyus":{"4":"maṭlaʿi","5":"l-faǧri"},"okuyanlar":["Abū Ǧaʿfar","Yaʿqūb"],"eser":"Ibn al-Ǧazarī (gest. 1429): an-Našr","eser_vefat":"833","kanonik_eser":0,"not":null},{"id":1659,"okuyus":{"3":"ḥattā","4":"maṭlaʿa"},"okuyanlar":["unbenannt (ohne nähere Angaben)"],"eser":"al-ʿUkbarī (gest. 1219): Iʿrāb","eser_vefat":"566","kanonik_eser":0,"not":null},{"id":1660,"okuyus":{"3":"ʾilā","4":"maṭlaʿi"},"okuyanlar":["Ubayy b. Kaʿb"],"eser":"an-Naḥḥās (gest. 950): Iʿrāb","eser_vefat":"338","kanonik_eser":0,"not":null},{"id":1661,"okuyus":{"3":"ḥattā","4":"maṭliʿi"},"okuyanlar":["al-Kisāʾī","ʿUbaid b. ʿUqail"],"eser":"Ibn Muǧāhid (gest. 936): Kitāb as-sabʿa","eser_vefat":"324","kanonik_eser":0,"not":null},{"id":1967,"okuyus":{"3":"ḥattā","4":"maṭliʿi","5":"l-faǧri"},"okuyanlar":["al-Kisāʾī"],"eser":"ad-Dānī (gest. 1053): at-Taisīr","eser_vefat":"444","kanonik_eser":1,"not":null},{"id":3959,"okuyus":{"4":"maṭlaʿi"},"okuyanlar":["ʿĀṣim","Abū ʿAmr","Ḥamza","Ibn ʿĀmir","Ibn Kaṯīr","Nāfiʿ"],"eser":"Ibn Muǧāhid (gest. 936): Kitāb as-sabʿa","eser_vefat":"324","kanonik_eser":0,"not":null},{"id":10906,"okuyus":{"4":"maṭliʿi"},"okuyanlar":["Yaḥyā b. Waṯṯāb"],"eser":"al-Farrāʾ (gest. 822): Maʿānī","eser_vefat":"207","kanonik_eser":0,"not":null},{"id":10907,"okuyus":{"4":"maṭlaʿi"},"okuyanlar":["allgemein übliche Lesart"],"eser":"al-Farrāʾ (gest. 822): Maʿānī","eser_vefat":"207","kanonik_eser":0,"not":null},{"id":11085,"okuyus":{"4":"maṭliʿi"},"okuyanlar":["Yaḥyā b. Waṯṯāb","al-Kisāʾī","al-Aʿmaš"],"eser":"aṭ-Ṭabarī (gest. 923): Tafsīr","eser_vefat":"310","kanonik_eser":0,"not":null},{"id":12799,"okuyus":{"4":"maṭliʿi"},"okuyanlar":["unbenannt (ohne nähere Angaben)"],"eser":"al-Ḫalīl b. Aḥmad (gest. 791): Kitāb al-ʿain","eser_vefat":"170","kanonik_eser":0,"not":"Die Lesart <i>maṭliʿi </i>wird im Eintrag zur Wurzel /ṭlʿ/ erwähnt, siehe Kitāb al-ʿain, Band 2, p. 11 nach der Edition al-Maḫzūmī/as-Sāmarrāʾī."},{"id":12800,"okuyus":{"4":"maṭlaʿi"},"okuyanlar":["unbenannt (ohne nähere Angaben)"],"eser":"al-Ḫalīl b. Aḥmad (gest. 791): Kitāb al-ʿain","eser_vefat":"170","kanonik_eser":0,"not":"Die Lesart <i>maṭlaʿi </i>wird im Eintrag zur Wurzel /ṭlʿ/ erwähnt, siehe Kitāb al-ʿain, Band 2, p. 11 nach der Edition al-Maḫzūmī/as-Sāmarrāʾī."},{"id":12846,"okuyus":{"4":"maṭliʿi"},"okuyanlar":["unbenannt (ohne nähere Angaben)"],"eser":"Ibn Ḫālawaih (gest. 981): Iʿrāb ṯalāṯīna ","eser_vefat":"370","kanonik_eser":0,"not":"<p>Ibn Ḫālawaih, Iʿrāb, p. 143: maṭlaʿi ǧarrun bi-ḥattā wa-ʾinnamā ḫafaḍat li-ʾanna t-taqdīra ʾilā maṭliʿi l-faǧri wa-l-maṭlaʿu maṣdarun yaʿni ṭ-ṭulūʿi wa-l-maṭliʿu (bi-l-kasri) l-mauḍiʿu. al-faǧri ǧarrun bi-l-ʾiḍāfati.</p><p>Die Lesart maṭlaʿi stellt ist eine Wortform, die das Verbalnomen des Verbs \"aufgehen\" darstellt, d.h. ḥattā maṭlaʿi l-faǧri würde bedeuten \"bis die Sonne aufgeht; bis zum Aufgang der Sonne\", während ḥattā maṭliʿi l-faǧri sich \"bis zum Sonnenaufgang; bis zum Ort, den dem die Sonne aufgeht\" verstehen lässt. Ibn Ḫālawaih leitet die Lesarten aus der unterschiedlichen Bedeutung der beiden Wortformen ab: Während die erste Form (matlaʿun) ein Verbalnomen darstellt, ist maṭliʿun ein Ortssubstantiv (<i>nomen loci</i>) und bezeichnet den Ort, an dem die Handlung stattfindet. Für einen weiteren Fall, bei dem die Unterscheidung zwischen Ortssubstantiv und Verbalnomen relevant ist, siehe die Lesarten madḫala und mudḫala in <a href=\"https://corpuscoranicum.de/lesarten/index/sure/4/vers/31\" target=\"_blank\">Q 4:31</a>, <a href=\"https://corpuscoranicum.de/lesarten/index/sure/17/vers/80\" target=\"_blank\">Q 17:80</a> und <a href=\"https://corpuscoranicum.de/lesarten/index/sure/22/vers/59\" target=\"_blank\">Q 22:59</a>.<br></p><p>Die beiden Lesart werden, ohne Angabe eines Lesers oder Überlieferers und ohne Bewertung, mit ihren unterschiedlichen Bedeutungen genannt. Unter den sieben Lesarten des Ibn Muǧāhid findet sich in der überwiegenden Mehrheit maṭlaʿi, wobei ein Leser der Sieben, al-Kisāʾī aus Kūfa die Form maṭliʿi vertritt.<br></p>"},{"id":12847,"okuyus":{"4":"maṭlaʿi"},"okuyanlar":["unbenannt (ohne nähere Angaben)"],"eser":"Ibn Ḫālawaih (gest. 981): Iʿrāb ṯalāṯīna ","eser_vefat":"370","kanonik_eser":0,"not":"<p>Ibn Ḫālawaih, Iʿrāb, p. 143: maṭlaʿi ǧarrun bi-ḥattā wa-ʾinnamā ḫafaḍat li-ʾanna t-taqdīra ʾilā maṭliʿi l-faǧri wa-l-maṭlaʿu maṣdarun yaʿni ṭ-ṭulūʿi wa-l-maṭliʿu (bi-l-kasri) l-mauḍiʿu. al-faǧri ǧarrun bi-l-ʾiḍāfati.</p><p>Die Lesart maṭlaʿi stellt ist eine Wortform, die das Verbalnomen des Verbs \"aufgehen\" darstellt, d.h. ḥattā maṭlaʿi l-faǧri würde bedeuten \"bis die Sonne aufgeht; bis zum Aufgang der Sonne\", während ḥattā maṭliʿi l-faǧri sich \"bis zum Sonnenaufgang; bis zum Ort, den dem die Sonne aufgeht\" verstehen lässt. Ibn Ḫālawaih leitet die Lesarten aus der unterschiedlichen Bedeutung der beiden Wortformen ab: Während die erste Form (matlaʿun) ein Verbalnomen darstellt, ist maṭliʿun ein Ortssubstantiv (<i>nomen loci</i>) und bezeichnet den Ort, an dem die Handlung stattfindet. Für einen weiteren Fall, bei dem die Unterscheidung zwischen Ortssubstantiv und Verbalnomen relevant ist, siehe die Lesarten madḫala und mudḫala in <a href=\"https://corpuscoranicum.de/lesarten/index/sure/4/vers/31\" target=\"_blank\">Q 4:31</a>, <a href=\"https://corpuscoranicum.de/lesarten/index/sure/17/vers/80\" target=\"_blank\">Q 17:80</a> und <a href=\"https://corpuscoranicum.de/lesarten/index/sure/22/vers/59\" target=\"_blank\">Q 22:59</a>.<br></p><p>Die beiden Lesart werden, ohne Angabe eines Lesers oder Überlieferers und ohne Bewertung, mit ihren unterschiedlichen Bedeutungen genannt. Unter den sieben Lesarten des Ibn Muǧāhid findet sich in der überwiegenden Mehrheit maṭlaʿi, wobei ein Leser der Sieben, al-Kisāʾī aus Kūfa die Form maṭliʿi vertritt.<br></p>"},{"id":12848,"okuyus":{"4":"maṭliʿ"},"okuyanlar":["al-Kisāʾī"],"eser":"Ibn Ḫālawaih (gest. 981): al-Ḥuǧǧa ","eser_vefat":"370","kanonik_eser":0,"not":null},{"id":12849,"okuyus":{"4":"maṭlaʿi"},"okuyanlar":["Mehrheit der Leser"],"eser":"Ibn Ḫālawaih (gest. 981): al-Ḥuǧǧa ","eser_vefat":"370","kanonik_eser":0,"not":null}],"qp":[{"kelime":"مَطْلَعِ","okuyus":"(مَطْلَعِ) بفتح اللام","raviler":[["ورش","نافع"],["روح","يعقوب"],["رويس","يعقوب"],["ابن جمّاز","أبو جعفر"],["ابن وردان","أبو جعفر"],["خلاد","حمزة"],["خلف","حمزة"],["حفص","عاصم"],["شعبة","عاصم"],["ابن ذكوان","ابن عامر"],["هشام","ابن عامر"],["السوسي","أبو عمرو"],["الدوري","أبو عمرو"],["قنبل","ابن كثير"],["البزي","ابن كثير"],["قالون","نافع"]]},{"kelime":"مَطْلَعِ","okuyus":"(مَطْلِعِ) بكسر اللام","raviler":[["أبو الحارث","الكسائي"],["الدوري","الكسائي"],["إسحاق","خلف"],["إدريس","خلف"]]}],"cc_ref":{"1":"سَلَٰمٌ","2":"هِیَ","3":"حَتَّىٰ","4":"مَطۡلَعِ","5":"ٱلۡفَجۡرِ"}}}}