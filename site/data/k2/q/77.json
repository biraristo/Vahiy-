er Leute aus dem Ḥiǧāz"],"eser":"al-Farrāʾ (gest. 822): Maʿānī","eser_vefat":"207","kanonik_eser":0,"not":null},{"id":12126,"okuyus":{"1":"ʿuḏran"},"okuyanlar":["Koranleser in Kufa","Koranleser in Medina","Koranleser in Syrien (Damaskus, Homs)","Lesart aus Kufa","Lesart aus Basra","Lesart aus Mekka"],"eser":"aṭ-Ṭabarī (gest. 923): Tafsīr","eser_vefat":"310","kanonik_eser":0,"not":null},{"id":12127,"okuyus":{"3":"nuḏran"},"okuyanlar":["Koranleser in Kufa","Lesart aus Basra"],"eser":"aṭ-Ṭabarī (gest. 923): Tafsīr","eser_vefat":"310","kanonik_eser":0,"not":null},{"id":13852,"okuyus":{"1":"ʿuḏran"},"okuyanlar":["einige (Grammatiker?, Koranleser?)"],"eser":"al-Aḫfaš al-Ausaṭ (gest. 830): Maʿānī","eser_vefat":"215","kanonik_eser":0,"not":"<p>al-Aḫfaš al-Auṣaṭ, Maʿānī al-qurʾān, edition Hudā Maḥmūd Qurāʿa, Cairo 1990, vol. 1, p. 110:</p><p><br></p><p>وَإِذْ قَالَ مُوسَى لِقَوْمِهِ إِنَّ اللَّهَ يَأْمُرُكُمْ أَنْ تَذْبَحُواْ بَقَرَةً قَالُواْ أَتَتَّخِذُنَا هُزُواً قَالَ أَعُوذُ بِاللَّهِ أَنْ أَكُونَ مِنَ الْجَاهِلِينَ}أما قوله {أَتَتَّخِذُنَا هُزُواً} فمن العرب والقراء من يثقله، ومنهم من يخففه وزعم عيسى بن عمر أنّ كلَ اسمٍ على ثلاثة أحرف أَوَّلُهُ مَضْموم فمن العرب من يثقله ومنهم من يخففه نحو: \"اليُسُر\" [و \"اليُسْر\"] ، و\"العُسُر\" [و\"العُسْر\"] ، و\"الرُحُم\" [و \"الرُحْم\"] . وقال بعضهم {عُذْراً} خفيفة {أونُذُراً} مثقلة، وهي كثيرة وبها نقرأ. وهذه اللغة التي ذكرها عيسى بن عمر تحرك أيضاً ثانية بالضم.</p>"},{"id":13853,"okuyus":{"1":"nuḏuran"},"okuyanlar":["unbenannt (ohne nähere Angaben)","Referenztext"],"eser":"al-Aḫfaš al-Ausaṭ (gest. 830): Maʿānī","eser_vefat":"215","kanonik_eser":0,"not":"<p>al-Aḫfaš al-Auṣaṭ, Maʿānī al-qurʾān, edition Hudā Maḥmūd Qurāʿa, Cairo 1990, vol. 1, p. 110:</p><p><br></p><p>وَإِذْ قَالَ مُوسَى لِقَوْمِهِ إِنَّ اللَّهَ يَأْمُرُكُمْ أَنْ تَذْبَحُواْ بَقَرَةً قَالُواْ أَتَتَّخِذُنَا هُزُواً قَالَ أَعُوذُ بِاللَّهِ أَنْ أَكُونَ مِنَ الْجَاهِلِينَ}أما قوله {أَتَتَّخِذُنَا هُزُواً} فمن العرب والقراء من يثقله، ومنهم من يخففه وزعم عيسى بن عمر أنّ كلَ اسمٍ على ثلاثة أحرف أَوَّلُهُ مَضْموم فمن العرب من يثقله ومنهم من يخففه نحو: \"اليُسُر\" [و \"اليُسْر\"] ، و\"العُسُر\" [و\"العُسْر\"] ، و\"الرُحُم\" [و \"الرُحْم\"] . وقال بعضهم {عُذْراً} خفيفة {أونُذُراً} مثقلة، وهي كثيرة وبها نقرأ. وهذه اللغة التي ذكرها عيسى بن عمر تحرك أيضاً ثانية بالضم.</p>"}],"qp":[{"kelime":"عُذْراً أَوْ نُذْراً إِنَّمَا","okuyus":"(عُذْرًا أَوْ نُذُرًا إِنَّما) إسكان الذال الأولى وضم الثانية وبنقل حركة الهمزتين إلى الساكن قبلهما ثم حذفهما","raviler":[["ورش","نافع"]]},{"kelime":"عُذْراً أَوْ نُذْراً إِنَّمَا","okuyus":"(عُذْرًا أَوْ نُذُرًا إِنَّمَا) إسكان الذال الأولى وضم الثانية وتحقيق الهمزتين دون سكت","raviler":[["البزي","ابن كثير"],["قنبل","ابن كثير"],["قالون","نافع"],["هشام","ابن عامر"],["ابن ذكوان","ابن عامر"],["شعبة","عاصم"],["رويس","يعقوب"],["ابن جمّاز","أبو جعفر"],["ابن وردان","أبو جعفر"]]},{"kelime":"عُذْراً أَوْ نُذْراً إِنَّمَا","okuyus":"(عُذْرًا أَوْ نُذْرًا إِنَّمَا) بإسكان الذال في الكلمتين وبتحقيق الهمزتين دون سكت","raviler":[["إدريس","خلف"],["إسحاق","خلف"],["الدوري","الكسائي"],["أبو الحارث","الكسائي"],["خلاد","حمزة"],["خلف","حمزة"],["حفص","عاصم"],["السوسي","أبو عمرو"],["الدوري","أبو عمرو"]]},{"kelime":"عُذْراً أَوْ نُذْراً إِنَّمَا","okuyus":"(عُذْرًا أَو نُذْرًا إِنَّمَا) بإسكان الذال في الكلمتين وبتحقيق الهمزتين مع السكت على الساكن قبلهما","raviler":[["خلف","حمزة"]]},{"kelime":"عُذْراً أَوْ نُذْراً إِنَّمَا","okuyus":"(عُذُرًا أَوْ نُذُرًا إِنَّمَا) بضم الذال في الكلمتين وبتحقيق الهمزتين دون سكت","raviler":[["روح","يعقوب"]]}],"cc_ref":{"1":"عُذۡرًا","2":"أَوۡ","3":"نُذۡرًا"}},"77:7":{"cc":[],"qp":[],"cc_ref":{"1":"إِنَّمَا","2":"تُوعَدُونَ","3":"لَوَٰقِعٌۭ"}},"77:8":{"cc":[{"id":1282,"okuyus":{"3":"ṭummisat"},"okuyanlar":["ʿAmr b. Maimūn"],"eser":"Abū Ḥayyān (gest. 1255): al-Baḥr al-muḥīṭ","eser_vefat":"745","kanonik_eser":0,"not":null},{"id":2417,"okuyus":{"3":"ṭummisat","1":"wa-ʾiḏa","2":"n-nuǧūmu"},"okuyanlar":["ʿAmr b. Maimūn"],"eser":"Ibn Ḫālawaih (gest. 981): Muḫtaṣar","eser_vefat":"370","kanonik_eser":0,"not"