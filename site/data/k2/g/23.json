 تفسير غريب القرآن","muellif":"ابن الهائم","nesir":"دار الغرب الإسلامي · الأولى","kelimeler":[{"k":"سُلالَةٍ مِنْ طِينٍ","a":"يعني آدم- عليه السلام- استلّ من طين، ويقال: سلّ من كل تربة. والسّلالة في اللغة: ما ينسلّ من الشيء القليل، وكذلك الفعالة، نحو: الفضالة والنّخالة والقلامة، والقوارة  ، والنّحاتة وما أشبه ذلك، وهذا قياسه."}]},{"eser":"تذكرة الأريب في تفسير الغريب","muellif":"ابن الجوزي","nesir":"دار الكتب العلمية، بيروت - لبنان · الأولى","kelimeler":[{"k":"من سلالة","a":"لأنه استل من جميع الأرض"}]},{"eser":"كلمات القرآن","muellif":"حسنين محمد مخلوف","nesir":"","kelimeler":[{"k":"سُلالة","a":"خُلاصة ( مائية مكونة من الغذاء )"}]}],"23:13":[{"eser":"السراج في بيان غريب القرآن","muellif":"محمد بن عبد العزيز الخضيري","nesir":"مكتبة الملك فهد الوطنية، المملكة العربية السعودية · الأولى، 1429 ه - 2008 م","kelimeler":[{"k":"نُطْفَةً","a":"مَنِيَّ الرِّجَالِ يَخْرُجُ مِنْ أَصْلَابِهِمْ."},{"k":"قَرَارٍ مَّكِينٍ","a":"هُوَ الرَّحِمُ تَسْتَقِرُّ فِيهِ النُّطْفَةُ."}]},{"eser":"كلمات القرآن","muellif":"حسنين محمد مخلوف","nesir":"","kelimeler":[{"k":"قرار مكين","a":"مستقر مُـتمكن وهو الرحم"}]}],"23:14":[{"eser":"السراج في بيان غريب القرآن","muellif":"محمد بن عبد العزيز الخضيري","nesir":"مكتبة الملك فهد الوطنية، المملكة العربية السعودية · الأولى، 1429 ه - 2008 م","kelimeler":[{"k":"عَلَقَةً","a":"دَمًا أَحْمَرَ مُلْتَصِقًا بِالرَّحِمِ."},{"k":"مُضْغَةً","a":"قِطْعَةَ لَحْمٍ قَدْرَ مَا يُمْضَغُ."}]},{"eser":"تذكرة الأريب في تفسير الغريب","muellif":"ابن الجوزي","nesir":"دار الكتب العلمية، بيروت - لبنان · الأولى","kelimeler":[{"k":"خلقا آخر","a":"وهو نفخ الروح فيه"},{"k":"أحسن الخالقين","a":"قال الأخفش الخالقون الصانعون فالله خير الخالقين"}]},{"eser":"كلمات القرآن","muellif":"حسنين محمد مخلوف","nesir":"","kelimeler":[{"k":"علقة","a":"دما متجمدا"},{"k":"مُضغة","a":"قطعة لحم قـَـدْر ما يُمضغ"},{"k":"خلقا آخر","a":"مباينا للأول بنفخ الروح فيه"},{"k":"فتبارك الله","a":"فتعالى .  أو تكاثر خيره وإحسانه"},{"k":"أحسن الخالقين","a":"أتقن الصانعين . أو المصورين"}]}],"23:15":[],"23:16":[],"23:17":[{"eser":"السراج في بيان غريب القرآن","muellif":"محمد بن عبد العزيز الخضيري","nesir":"مكتبة الملك فهد الوطنية، المملكة العربية السعودية · الأولى، 1429 ه - 2008 م","kelimeler":[{"k":"طَرَائِقَ","a":"سَمَوَاتٍ بَعْضُهَا فَوْقَ بَعْضٍ."}]},{"eser":"التبيان في تفسير غريب القرآن","muellif":"ابن الهائم","nesir":"دار الغرب الإسلامي · الأولى","kelimeler":[{"k":"سَبْعَ طَرائِقَ","a":"أي سبع سموات، واحدتها طريقة. وسمّيت طرائق لتطارق بعضها فوق بعض."}]},{"eser":"تذكرة الأريب في تفسير الغريب","muellif":"ابن الجوزي","nesir":"دار الكتب العلمية، بيروت - لبنان · الأولى","kelimeler":[{"k":"سبع طرائق","a":"يعني السموات السبع"}]},{"eser":"كلمات القرآن","muellif":"حسنين محمد مخلوف","nesir":"","kelimeler":[{"k":"سبع طرائق","a":"سبع سموات طباقا أو طُرُقا للملائكة أو للكواكب في مسيرها"}]}],"23:18":[{"eser":"السراج في بيان غريب القرآن","muellif":"محمد بن عبد العزيز الخضيري","nesir":"مكتبة الملك فهد الوطنية، المملكة العربية السعودية · الأولى، 1429 ه - 2008 م","kelimeler":[{"k":"بِقَدَرٍ","a":"بِمِقْدَارِ حَاجَةِ الخَلْقِ."}]},{"eser":"تذكرة الأريب في تفسير الغريب","muellif":"ابن الجوزي","nesir":"دار الكتب العلمية، بيروت - لبنان · الأولى","kelimeler":[{"k":"بقدر","a":"أي بقدر ما يكفيهم"}]},{"eser":"كلمات القرآن","muellif":"حسنين محمد مخلوف","nesir":"","kelimeler":[{"k":"بقدَر","a":"بمقدار الحاجة والمصلحة"}]}],"23:19":[],"23:20":[{"eser":"السراج في بيان غريب القرآن","muellif":"محمد بن عبد العزيز الخضيري","nesir":"مكتبة الملك فهد الوطنية، المملكة العربية السعودية · الأولى، 1429 ه - 2008 م","kelimeler":[{"k":"وَشَجَرَةً","a":"هِيَ شَجَرَةُ الزَّيْتُونِ."},{"k":"بِالدُّهْنِ","a":"بِالزَّيْتِ."},{"k":"وَصِبْغٍ","a":"إِدَامٍ يُغْمَسُ فِيهِ الخُبْزُ."}]},{"eser":"التبيان في تفسير غريب القرآن","muellif":"ابن الهائم","nesir":"دار الغرب الإسلامي · الأولى","kelimeler":[{"k":"تَنْبُتُ بِالدُّهْنِ","a":"بضم التاء، أي تنبت ما تنبته بالدّهن كأنه- واللهأعلم- يخرج ثمرها ومعه الدّهن، وقال قوم: الباء الزائدة يعني أنها تنبت الدّهن، أي ما يعصر فيكون دهنا. ومن قرأ تنبت بفتح التاء وضم الباء  فتأويله: كأنها ت