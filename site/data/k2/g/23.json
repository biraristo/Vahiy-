هد الوطنية، المملكة العربية السعودية · الأولى، 1429 ه - 2008 م","kelimeler":[{"k":"تَتْرَا","a":"يَتْبَعُ بَعْضُهُمْ بَعْضًا."},{"k":"أَحَادِيثَ","a":"أَخْبَارًا لِمَنْ بَعْدَهُمْ."}]},{"eser":"التبيان في تفسير غريب القرآن","muellif":"ابن الهائم","nesir":"دار الغرب الإسلامي · الأولى","kelimeler":[{"k":"تَتْرا وتَتْرا","a":"فعلى وفعلى، من المواترة، وهي المتابعة، فمن لم يصرفها جعل ألفها للتأنيث، ومن صرفها جعل ألفها للإلحاق كأنها ملحقة ب «فعلل» وأصل «تترى» «وترى» فأبدلت التاء من الواو، كما أبدلت في تراث وتجاه. ويجوز في قول الفرّاء أن تقول في الرفع تتر، وفي الخفض تتر، وفيالنصب تترا، فيكون الألف في «تترا» على هذا بدلا من التنوين."},{"k":"أَحادِيثَ","a":"أي جعلناهم أخبارا وعبرا يتمثّل بهم في الشرّ  لا يقال: جعلته حديثا في الخير."}]},{"eser":"تذكرة الأريب في تفسير الغريب","muellif":"ابن الجوزي","nesir":"دار الكتب العلمية، بيروت - لبنان · الأولى","kelimeler":[{"k":"تترا","a":"نتابع بفترة بين كل رسولين"},{"k":"فأتبعنا بعضهم بعضا","a":"أي أهلكنا بعضهم في إثر بعض"},{"k":"أحاديث","a":"يتمثل بهم في الشر ولا يقال في الخير حديث"}]},{"eser":"كلمات القرآن","muellif":"حسنين محمد مخلوف","nesir":"","kelimeler":[{"k":"تتـْـرى","a":"متتابعين على فترات"},{"k":"جعلناهم أحاديث","a":"مجرد أخبار للتعَجّب والتلهّي"}]}],"23:45":[{"eser":"السراج في بيان غريب القرآن","muellif":"محمد بن عبد العزيز الخضيري","nesir":"مكتبة الملك فهد الوطنية، المملكة العربية السعودية · الأولى، 1429 ه - 2008 م","kelimeler":[{"k":"بِآيَاتِنَا","a":"وَهِيَ تِسْعٌ: العَصَا، وَاليَدُ، وَالجَرَادُ، وَالقُمَّلُ، وَالضَّفَادِعُ، وَالدَّمُ، وَالطُّوفَانُ، وَالسِّنُونَ، وَنَقْصُ الثَّمَرَاتِ."}]},{"eser":"كلمات القرآن","muellif":"حسنين محمد مخلوف","nesir":"","kelimeler":[{"k":"سُلطان مبين","a":"برهان بَيّن ٍ  مُظهر للحق"}]}],"23:46":[{"eser":"السراج في بيان غريب القرآن","muellif":"محمد بن عبد العزيز الخضيري","nesir":"مكتبة الملك فهد الوطنية، المملكة العربية السعودية · الأولى، 1429 ه - 2008 م","kelimeler":[{"k":"عَالِينَ","a":"مُتَكَبِّرِينَ مُتَطَاوِلِينَ عَلَى النَّاسِ."}]},{"eser":"تذكرة الأريب في تفسير الغريب","muellif":"اب