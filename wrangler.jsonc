{
  // vahiy++ — statik site + R2 kütüphane deposu, Cloudflare Workers
  "name": "vahiy",
  "compatibility_date": "2025-09-01",
  "main": "worker.js",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/r2/*"]
  },
  "r2_buckets": [{ "binding": "KUTUP", "bucket_name": "vahiy" }]
}
